---
/**
 * 页头组件 Header · Paper Lab 纸感实验室
 *
 * 网站顶部导航栏：烧瓶 Logo、导航菜单、语言切换、移动端抽屉
 *
 * @component Header
 */

import { useTranslations, getLocalizedPath } from '../utils/i18n';
import { languages } from '../i18n/config';

interface Props {
  lang?: string;
  currentPath?: string;
}

const { lang = 'en', currentPath = '/' } = Astro.props;

const t = useTranslations(lang);

// 导航菜单配置
const navItems = [
  { key: 'home', path: '/' },
  { key: 'boards', path: '/boards' },
  { key: 'modules', path: '/modules' },
  { key: 'experiments', path: '/experiments' },
  { key: 'solutions', path: '/solutions' },
  { key: 'printing', path: '/printing' },
  { key: 'articles', path: '/articles' },
];

// 语言选项（按 demo 顺序）
const langOrder = ['zh-cn', 'en', 'zh-tw', 'ja', 'ko', 'es', 'de', 'fr', 'it'] as const;

// 当前路径去掉语言前缀，用于构建语言切换链接
const langPrefix = `/${lang}`;
const pathWithoutLang = currentPath.startsWith(langPrefix)
  ? currentPath.slice(langPrefix.length) || '/'
  : currentPath;
const langHref = (code: string) =>
  pathWithoutLang === '/' ? `/${code}/` : `/${code}${pathWithoutLang}`;

// 导航激活判定：首页精确匹配，其余栏目前缀匹配（详情页也保持高亮）
const isActive = (itemPath: string) => {
  const localized = getLocalizedPath(itemPath, lang);
  if (itemPath === '/') {
    return currentPath === localized || currentPath === `${localized}`.replace(/\/$/, '');
  }
  return currentPath === localized || currentPath.startsWith(`${localized}/`);
};
---

<header class="site-header">
  <div class="container">
    <a class="brand" href={getLocalizedPath('/', lang)} aria-label="LINGFLUX Home">
      <svg class="brand-logo" viewBox="0 0 32 32" fill="none" aria-hidden="true">
        <path d="M13 3h6M14.5 3v8.2L7.6 23.5A3.4 3.4 0 0 0 10.6 28.5h10.8a3.4 3.4 0 0 0 3-12.3L17.5 11.2V3" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"/>
        <path d="M10.5 19h11" style="stroke: var(--accent)" stroke-width="2.2" stroke-linecap="round"/>
        <circle cx="14" cy="23.5" r="1.6" style="fill: var(--accent)"/>
        <circle cx="18.5" cy="25" r="1.2" style="fill: var(--green)"/>
      </svg>
      LINGFLUX
    </a>

    <nav class="main-nav" aria-label="Main navigation">
      {navItems.map(item => (
        <a
          href={getLocalizedPath(item.path, lang)}
          class={isActive(item.path) ? 'active' : ''}
        >
          {t(`nav.${item.key}` as any)}
        </a>
      ))}
    </nav>

    <div class="header-actions">
      <div class="theme-switch">
        <button class="icon-btn" aria-label="Switch theme" type="button">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="9"/><path d="M12 3a9 9 0 0 1 0 18V3z" fill="currentColor" stroke="none" opacity="0.8"/></svg>
        </button>
        <div class="lang-panel theme-panel">
          <button type="button" data-theme-choice="paper">
            Paper Lab <span class="code">纸感 · 默认</span>
          </button>
          <button type="button" data-theme-choice="ocean">
            Ocean Deep <span class="code">深海</span>
          </button>
        </div>
      </div>
      <div class="lang-switch">
        <button class="icon-btn" aria-label="Switch language" type="button">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><path d="M2 12h20M12 2a15.3 15.3 0 0 1 4 10 15.3 15.3 0 0 1-4 10 15.3 15.3 0 0 1-4-10 15.3 15.3 0 0 1 4-10z"/></svg>
        </button>
        <div class="lang-panel">
          {langOrder.map(code => (
            <a href={langHref(code)} class={code === lang ? 'on' : ''}>
              {languages[code]} <span class="code">{code}</span>
            </a>
          ))}
        </div>
      </div>
      <button class="icon-btn nav-toggle" aria-label="Open menu" type="button">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"><path d="M4 7h16M4 12h16M4 17h16"/></svg>
      </button>
    </div>
  </div>
</header>

<div class="nav-backdrop"></div>
<aside class="nav-drawer" aria-label="Mobile navigation">
  <div class="drawer-head">
    <strong>LINGFLUX</strong>
    <button class="icon-btn nav-drawer-close" aria-label="Close menu" type="button">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"><path d="M6 6l12 12M18 6 6 18"/></svg>
    </button>
  </div>
  {navItems.map(item => (
    <a
      href={getLocalizedPath(item.path, lang)}
      class={isActive(item.path) ? 'active' : ''}
    >
      {t(`nav.${item.key}` as any)}
    </a>
  ))}
  <div class="drawer-theme">
    <div class="drawer-label">Theme</div>
    <button type="button" data-theme-choice="paper">
      Paper Lab <span class="code">纸感 · 默认</span>
    </button>
    <button type="button" data-theme-choice="ocean">
      Ocean Deep <span class="code">深海</span>
    </button>
  </div>
  <div class="drawer-lang">
    {langOrder.map(code => (
      <a href={langHref(code)} class={code === lang ? 'on' : ''}>
        {languages[code]} <span class="code">{code}</span>
      </a>
    ))}
  </div>
</aside>
