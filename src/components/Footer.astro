---
/**
 * 页脚组件 Footer · Paper Lab 纸感实验室
 *
 * 网站底部区域：品牌信息、快速导航、友情链接、社交媒体、版权信息
 *
 * @component Footer
 */

import { useTranslations, getLocalizedPath } from '../utils/i18n';
import { defaultLang } from '../i18n/config';

interface Props {
  lang?: string;
}

const { lang = defaultLang } = Astro.props;

const t = useTranslations(lang as any);

// 当前年份
const currentYear = new Date().getFullYear();

// 快速导航
const quickLinks = [
  { key: 'nav.home', path: '/' },
  { key: 'nav.boards', path: '/boards' },
  { key: 'nav.modules', path: '/modules' },
  { key: 'nav.experiments', path: '/experiments' },
  { key: 'nav.solutions', path: '/solutions' },
  { key: 'nav.printing', path: '/printing' },
  { key: 'nav.articles', path: '/articles' },
];

// 友情链接配置
const friendLinks = [
  { name: 'LingShun LAB', url: 'https://www.lingshunlab.com' },
  { name: 'Maker Onsite', url: 'https://makeronsite.com' },
  { name: 'Free AI Tool', url: 'https://freeaitool.com' },
  { name: 'DaShen Tech', url: 'https://dashen-tech.com' },
];

// 社交媒体配置
const socialLinks = [
  { name: 'GitHub', url: 'https://github.com/ling3ye' },
  { name: 'YouTube', url: 'https://www.youtube.com/@lingshunlab' },
  { name: 'Discord', url: 'https://discord.gg/5kQadTYrVu' },
];

const socialIcons: Record<string, string> = {
  'GitHub': `<svg viewBox="0 0 24 24" fill="currentColor"><path d="M12 .5C5.65.5.5 5.65.5 12c0 5.08 3.29 9.39 7.86 10.91.58.11.79-.25.79-.55v-2.15c-3.2.7-3.87-1.36-3.87-1.36-.52-1.33-1.28-1.69-1.28-1.69-1.04-.71.08-.7.08-.7 1.15.08 1.76 1.19 1.76 1.19 1.03 1.75 2.69 1.25 3.35.95.1-.74.4-1.25.72-1.54-2.55-.29-5.24-1.28-5.24-5.68 0-1.26.45-2.28 1.19-3.09-.12-.29-.52-1.46.11-3.05 0 0 .97-.31 3.18 1.18a11.1 11.1 0 0 1 5.8 0c2.2-1.49 3.17-1.18 3.17-1.18.63 1.59.23 2.76.11 3.05.74.81 1.19 1.83 1.19 3.09 0 4.41-2.7 5.38-5.26 5.67.41.35.77 1.05.77 2.12v3.15c0 .3.21.67.8.55A11.51 11.51 0 0 0 23.5 12C23.5 5.65 18.35.5 12 .5Z"/></svg>`,
  'YouTube': `<svg viewBox="0 0 24 24" fill="currentColor"><path d="M23.5 7.2s-.23-1.63-.95-2.35c-.9-.95-1.92-.96-2.38-1.02C16.9 3.5 12 3.5 12 3.5h-.01s-4.9 0-8.16.33c-.47.06-1.48.07-2.38 1.02-.72.72-.95 2.35-.95 2.35S.26 9.12.26 11.03v1.79c0 1.91.24 3.83.24 3.83s.23 1.63.95 2.35c.9.95 2.09.92 2.62 1.02 1.9.18 8.06.33 8.06.33s4.91 0 8.17-.34c.47-.06 1.48-.07 2.38-1.02.72-.72.95-2.35.95-2.35s.24-1.91.24-3.83v-1.79c0-1.91-.24-3.83-.24-3.83ZM9.7 14.98V8.66l6.4 3.17-6.4 3.15Z"/></svg>`,
  'Discord': `<svg viewBox="0 0 24 24" fill="currentColor"><path d="M20.32 4.37a19.8 19.8 0 0 0-4.89-1.52.07.07 0 0 0-.08.04c-.21.38-.44.86-.61 1.25a18.27 18.27 0 0 0-5.49 0 12.6 12.6 0 0 0-.61-1.25.08.08 0 0 0-.08-.04 19.74 19.74 0 0 0-4.88 1.52.07.07 0 0 0-.03.03C.53 9.05-.32 13.58.1 18.06a.08.08 0 0 0 .03.06 19.9 19.9 0 0 0 5.99 3.03.08.08 0 0 0 .08-.03c.46-.63.87-1.3 1.23-2a.08.08 0 0 0-.04-.1 13.1 13.1 0 0 1-1.87-.9.08.08 0 0 1-.01-.13c.13-.09.25-.19.37-.29a.07.07 0 0 1 .08-.01c3.93 1.8 8.18 1.8 12.06 0a.07.07 0 0 1 .08.01c.12.1.25.2.37.29a.08.08 0 0 1-.01.13c-.59.35-1.22.64-1.87.9a.08.08 0 0 0-.04.1c.36.7.77 1.36 1.22 2a.08.08 0 0 0 .08.02 19.84 19.84 0 0 0 6.01-3.03.08.08 0 0 0 .03-.05c.5-5.18-.84-9.68-3.55-13.66a.06.06 0 0 0-.03-.03ZM8.02 15.33c-1.18 0-2.16-1.09-2.16-2.42 0-1.33.96-2.42 2.16-2.42 1.21 0 2.18 1.1 2.16 2.42 0 1.33-.96 2.42-2.16 2.42Zm7.97 0c-1.18 0-2.15-1.09-2.15-2.42 0-1.33.95-2.42 2.15-2.42 1.21 0 2.18 1.1 2.16 2.42 0 1.33-.95 2.42-2.16 2.42Z"/></svg>`,
};
---

<footer class="site-footer">
  <div class="container">
    <div class="footer-grid">
      <!-- 品牌信息 -->
      <div class="footer-brand">
        <a class="brand" href={getLocalizedPath('/', lang)}>
          <svg class="brand-logo" viewBox="0 0 32 32" fill="none" aria-hidden="true">
            <path d="M13 3h6M14.5 3v8.2L7.6 23.5A3.4 3.4 0 0 0 10.6 28.5h10.8a3.4 3.4 0 0 0 3-12.3L17.5 11.2V3" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"/>
            <path d="M10.5 19h11" style="stroke: var(--accent)" stroke-width="2.2" stroke-linecap="round"/>
            <circle cx="14" cy="23.5" r="1.6" style="fill: var(--accent)"/>
            <circle cx="18.5" cy="25" r="1.2" style="fill: var(--green)"/>
          </svg>
          LINGFLUX
        </a>
        <p>{t('footer.description')} · {t('site.slogan')}</p>
        <div class="social-row">
          {socialLinks.map(link => (
            <a class="icon-btn" href={link.url} target="_blank" rel="noopener noreferrer" aria-label={link.name}>
              <Fragment set:html={socialIcons[link.name]} />
            </a>
          ))}
        </div>
      </div>

      <!-- 快速导航 -->
      <div class="footer-col">
        <h5>{t('footer.resources')}</h5>
        <ul>
          {quickLinks.map(link => (
            <li><a href={getLocalizedPath(link.path, lang)}>{t(link.key as any)}</a></li>
          ))}
        </ul>
      </div>

      <!-- 友情链接 -->
      <div class="footer-col">
        <h5>{t('footer.links')}</h5>
        <ul>
          {friendLinks.map(link => (
            <li>
              <a href={link.url} target="_blank" rel="noopener noreferrer">
                {link.name}
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M7 17 17 7M9 7h8v8"/></svg>
              </a>
            </li>
          ))}
        </ul>
      </div>
    </div>

    <div class="footer-bottom">
      <span>© {currentYear} LINGFLUX · {t('footer.allRightsReserved')}</span>
      <span>{t('site.slogan')}</span>
    </div>
  </div>
</footer>
