---
/**
 * 卡片组件 Card · Paper Lab 纸感实验室
 *
 * 统一卡片组件：
 * - article / model：图文卡（有图显图，无图为文字卡）
 * - board / module / printer / filament：硬件手册卡（品牌 + 规格表 + 价格）
 * - featured：首页精选大卡
 *
 * @component Card
 */

import { useTranslations } from '../utils/i18n';
import { defaultLang, type SupportedLocale } from '../i18n/config';

interface Props {
  type?: 'article' | 'board' | 'module' | 'printer' | 'filament' | 'model';
  title: string;
  description?: string;
  image?: string;
  link?: string;
  tags?: string[];
  date?: Date;
  difficulty?: 'Easy' | 'Medium' | 'Hard';
  featured?: boolean;
  brand?: string;
  specs?: Record<string, string | number | boolean>;
  locale?: SupportedLocale;
  affiliateUrl?: string;
  makerWorldUrl?: string;
  priceRange?: string;
  compareId?: string;
  /** 硬件卡左上角分类/属性 chip 文案 */
  catLabel?: string;
  /** 图文卡不显示图片上的悬浮标签（tags[0] 不渲染为 float-tag） */
  hideFloatTag?: boolean;
  /** 任意 data-* 属性会自动透传到卡片根元素（供筛选脚本使用） */
  [key: `data-${string}`]: string | undefined;
}

const {
  type = 'article',
  title,
  description = '',
  image,
  link,
  tags = [],
  date,
  difficulty,
  featured = false,
  brand,
  specs,
  locale = defaultLang,
  priceRange,
  catLabel,
  hideFloatTag = false,
} = Astro.props;

// 透传 data-* 属性（供列表页筛选脚本读取 dataset）
const dataAttrs = Object.fromEntries(
  Object.entries(Astro.props).filter(([k]) => k.startsWith('data-'))
) as Record<string, string>;

const t = useTranslations(locale);

// 各类型「阅读」按钮文案
const readKeys: Record<string, string> = {
  article: 'card.readMore',
  model: 'card.viewModel',
  board: 'card.viewBoard',
  module: 'card.viewModule',
  printer: 'card.viewPrinter',
  filament: 'card.viewFilament',
};
const readKey = readKeys[type] || 'card.readMore';

// 硬件类卡片
const isHardware = ['board', 'module', 'printer', 'filament'].includes(type);

// 硬件类型图标
const typeIcons: Record<string, string> = {
  board: '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"><rect x="6" y="6" width="12" height="12" rx="2"/><path d="M9 6V3M15 6V3M9 21v-3M15 21v-3M6 9H3M6 15H3M21 9h-3M21 15h-3"/></svg>',
  module: '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M14 7h3a2 2 0 0 1 2 2v3a2 2 0 0 1-2 2h-3v3a2 2 0 0 1-2 2H9a2 2 0 0 1-2-2v-3H4a2 2 0 0 1-2-2V9a2 2 0 0 1 2-2h3V4a2 2 0 0 1 2-2h3a2 2 0 0 1 2 2v3Z"/></svg>',
  printer: '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M6 9V2h12v7M6 18H4a2 2 0 0 1-2-2v-5a2 2 0 0 1 2-2h16a2 2 0 0 1 2 2v5a2 2 0 0 1-2 2h-2"/><rect x="6" y="14" width="12" height="8" rx="1"/></svg>',
  filament: '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="9"/><circle cx="12" cy="12" r="3"/><path d="M12 3v3M12 18v3M3 12h3M18 12h3"/></svg>',
  model: '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M21 8 12 3 3 8v8l9 5 9-5V8Z"/><path d="M3 8l9 5 9-5M12 13v8"/></svg>',
  article: '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8Z"/><path d="M14 2v6h6M8 13h8M8 17h5"/></svg>',
};

// 难度 chip 样式映射
const difficultyChip: Record<string, string> = {
  Easy: 'chip--green',
  Medium: 'chip--accent',
  Hard: 'chip--ink',
};

// 格式化日期
const formatDate = (d: Date) => {
  const localeMap: Record<string, string> = {
    'zh-cn': 'zh-CN', 'zh-tw': 'zh-TW', 'en': 'en-US', 'ja': 'ja-JP',
    'ko': 'ko-KR', 'es': 'es-ES', 'de': 'de-DE', 'fr': 'fr-FR', 'it': 'it-IT',
  };
  return d.toLocaleDateString(localeMap[locale] || 'en-US', {
    year: 'numeric', month: 'short', day: 'numeric',
  });
};

// 规格摘要（硬件卡最多 2 条）
const specEntries = specs ? Object.entries(specs).slice(0, 2) : [];

const arrowSvg = '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14M13 6l6 6-6 6"/></svg>';
---

{/* ============ 精选大卡 ============ */}
{featured ? (
  <article class="card-feature reveal" {...dataAttrs}>
    {image && (
      <div class="media">
        <span class="tape" aria-hidden="true"></span>
        {link ? <a href={link} class="card-img-link"><img src={image} alt={title} loading="lazy" /></a> : <img src={image} alt={title} loading="lazy" />}
      </div>
    )}
    <div class="body">
      <div class="card-meta">
        {tags.map(tag => <span class="chip chip--accent">{tag}</span>)}
        {difficulty && <span class={`chip ${difficultyChip[difficulty]}`}>{difficulty}</span>}
      </div>
      <h3>{link ? <a href={link}>{title}</a> : title}</h3>
      {description && <p>{description}</p>}
      {link && (
        <div>
          <a class="btn btn--primary" href={link}>
            {t(readKey as any)}
            <Fragment set:html={arrowSvg} />
          </a>
        </div>
      )}
    </div>
  </article>
) : isHardware ? (
  /* ============ 硬件手册卡 ============ */
  <article class="card module-card reveal" {...dataAttrs}>
    {image ? (
      /* 有图：整行通栏封面，分类 chip 悬浮右上角（避开封面图左侧标题区） */
      <div class="module-media">
        {link ? <a href={link} class="card-img-link"><img src={image} alt={title} loading="lazy" /></a> : <img src={image} alt={title} loading="lazy" />}
        {catLabel && <span class="chip chip--pen float-cat">{catLabel}</span>}
        {!catLabel && difficulty && <span class={`chip float-cat ${difficultyChip[difficulty]}`}>{difficulty}</span>}
      </div>
    ) : (
      /* 无图：图标 + chip 行 */
      <div class="top">
        <span class="module-icon"><Fragment set:html={typeIcons[type]} /></span>
        {catLabel && <span class="chip chip--pen">{catLabel}</span>}
        {!catLabel && difficulty && <span class={`chip ${difficultyChip[difficulty]}`}>{difficulty}</span>}
      </div>
    )}
    <div>
      {brand && <div class="brand">{brand}</div>}
      <h3>{link ? <a href={link}>{title}</a> : title}</h3>
    </div>
    {specEntries.length > 0 && (
      <dl class="spec-list">
        {specEntries.map(([k, v]) => (
          <div class="spec-row"><dt>{k}</dt><dd>{String(v)}</dd></div>
        ))}
      </dl>
    )}
    <div class="card-foot">
      {priceRange ? <span class="price-tag">{priceRange}</span> : <span></span>}
      {link && (
        <a class="card-link" href={link}>
          {t(readKey as any)}
          <Fragment set:html={arrowSvg} />
        </a>
      )}
    </div>
  </article>
) : image ? (
  /* ============ 图文卡 ============ */
  <article class="card reveal" {...dataAttrs}>
    <div class="card-media">
      {!hideFloatTag && tags.length > 0 && <span class="chip chip--ink float-tag">{tags[0]}</span>}
      {link ? <a href={link} class="card-img-link"><img src={image} alt={title} loading="lazy" /></a> : <img src={image} alt={title} loading="lazy" />}
    </div>
    <div class="card-body">
      <div class="card-meta">
        {tags.slice(hideFloatTag ? 0 : (image ? 1 : 0)).map(tag => <span class="chip">{tag}</span>)}
        {difficulty && <span class={`chip ${difficultyChip[difficulty]}`}>{difficulty}</span>}
      </div>
      <h3 class="card-title">{link ? <a href={link}>{title}</a> : title}</h3>
      {description && <p class="card-desc">{description}</p>}
      <div class="card-foot">
        {date ? <time datetime={date.toISOString()}>{formatDate(date)}</time> : <span></span>}
        {link && (
          <a class="card-link" href={link}>
            {t(readKey as any)}
            <Fragment set:html={arrowSvg} />
          </a>
        )}
      </div>
    </div>
  </article>
) : (
  /* ============ 纯文字卡 ============ */
  <article class="card article-card reveal" {...dataAttrs}>
    <div class="domain-row">
      <span class="card-meta">
        {tags.map(tag => <span class="chip chip--accent">{tag}</span>)}
        {difficulty && <span class={`chip ${difficultyChip[difficulty]}`}>{difficulty}</span>}
      </span>
      {date && <time datetime={date.toISOString()}>{formatDate(date)}</time>}
    </div>
    <h3 class="card-title">{link ? <a href={link}>{title}</a> : title}</h3>
    {description && <p class="card-desc">{description}</p>}
    <div class="card-foot">
      <span></span>
      {link && (
        <a class="card-link" href={link}>
          {t(readKey as any)}
          <Fragment set:html={arrowSvg} />
        </a>
      )}
    </div>
  </article>
)}

<style>
  /* 图片链接：保证 img 被 a 包裹时布局不变 */
  .card-img-link {
    display: block;
    width: 100%;
    height: 100%;
  }
  .card-img-link img {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  /* 硬件卡封面：整行通栏，16:9 自适应卡宽（与模块封面图源比例一致，零裁切） */
  .module-media {
    position: relative;
    margin: -24px -24px 0; /* 抵消 .module-card 内边距，实现通栏出血 */
    aspect-ratio: 16 / 9;
    overflow: hidden;
    background: var(--paper-2);
    border-bottom: 1px solid var(--line);
  }
  .module-media img {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.5s cubic-bezier(0.22, 1, 0.36, 1);
  }
  .module-card:hover .module-media img { transform: scale(1.05); }
  /* 悬浮分类 chip：实底贴纸感，避免压在照片上读不清 */
  .module-media .float-cat {
    position: absolute;
    z-index: 2;
    top: 12px;
    right: 12px;
    background: var(--card);
    box-shadow: var(--shadow-1);
  }
</style>
