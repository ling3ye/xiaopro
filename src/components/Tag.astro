---
/**
 * 标签组件 Tag · Paper Lab 纸感实验室（chip 风格）
 *
 * @component Tag
 */

interface Props {
  name: string;
  href?: string;
  variant?: 'default' | 'accent' | 'pen' | 'green' | 'ink' | string;
  size?: 'sm' | 'md';
  compact?: boolean;
}

const { name, href, variant = 'default', compact = false } = Astro.props;

const variantClass: Record<string, string> = {
  default: '',
  accent: 'chip--accent',
  pen: 'chip--pen',
  green: 'chip--green',
  ink: 'chip--ink',
  // 兼容旧调用（难度颜色等）
  success: 'chip--green',
  warning: 'chip--accent',
  error: 'chip--ink',
};

const cls = `chip ${variantClass[variant] || ''}`;
---

{href ? (
  <a href={href} class={cls}>{name}</a>
) : (
  <span class={cls}>{name}</span>
)}
