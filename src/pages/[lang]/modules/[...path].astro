---
/**
 * 外设模块 - 列表页和详情页 · Paper Lab 纸感实验室
 *
 * @route /[lang]/modules/[...path]
 */

import Layout from '../../../layouts/Layout.astro';
import Card from '../../../components/Card.astro';
import Breadcrumb from '../../../components/Breadcrumb.astro';
import AffiliateLink from '../../../components/AffiliateLink.astro';
import { getCollection, getEntry } from 'astro:content';
import { useTranslations, getLocalizedPath } from '../../../utils/i18n';
import { languages } from '../../../i18n/config';
import type { SupportedLocale } from '../../../i18n/config';

export async function getStaticPaths() {
  const paths: any[] = [];

  const modules = await getCollection('modules');

  for (const lang of Object.keys(languages)) {
    paths.push({ params: { lang, path: undefined } });

    modules.forEach((module) => {
      paths.push({ params: { lang, path: module.id } });
    });
  }

  return paths;
}

const { lang, path: id } = Astro.params;
const currentLocale: SupportedLocale = lang as SupportedLocale;
const t = useTranslations(currentLocale);

const isListPage = !id;

const allModules = await getCollection('modules');

// 详情页数据
let module = null;
let relatedExperiments: any[] = [];
let relatedSolutions: any[] = [];
let currentDoc = null;

if (!isListPage) {
  module = await getEntry('modules', id);
  if (module) {
    relatedExperiments = await getCollection('experiments', (entry) => {
      const matchSingle = 'moduleId' in entry.data &&
             (entry.data.moduleId.id || String(entry.data.moduleId)) === id;
      const matchMultiple = 'moduleIds' in entry.data &&
             Array.isArray(entry.data.moduleIds) &&
             entry.data.moduleIds.some((moduleRef: any) => {
               return (moduleRef.id || String(moduleRef)) === id;
             });
      return (matchSingle || matchMultiple) && entry.id.includes(`/${lang}/`);
    });

    relatedSolutions = await getCollection('solutions', (entry) => {
      return 'moduleIds' in entry.data &&
             Array.isArray(entry.data.moduleIds) &&
             entry.data.moduleIds.some((moduleRef: any) => {
               return (moduleRef.id || String(moduleRef)) === id;
             }) &&
             entry.id.startsWith(`${lang}/`);
    });

    const allModuleDocs = await getCollection('moduleDocs', (entry) => {
      return 'moduleId' in entry.data && entry.data.moduleId;
    });

    currentDoc = allModuleDocs.find((doc: any) => {
      const docModuleId = (doc.data.moduleId as any).id || String(doc.data.moduleId);
      return docModuleId === id && doc.id.startsWith(`${lang}/`);
    });
  }
}

// 按分类分组
const modulesByCategory: Record<string, typeof allModules> = {
  sensor: allModules.filter(m => m.data.category === 'sensor'),
  display: allModules.filter(m => m.data.category === 'display'),
  actuator: allModules.filter(m => m.data.category === 'actuator'),
  communication: allModules.filter(m => m.data.category === 'communication'),
  audio: allModules.filter(m => m.data.category === 'audio'),
  power: allModules.filter(m => m.data.category === 'power'),
  storage: allModules.filter(m => m.data.category === 'storage'),
  lighting: allModules.filter(m => m.data.category === 'lighting'),
  other: allModules.filter(m => m.data.category === 'other'),
};

// 分类名称（补齐 audio）
const categoryNames: Record<string, string> = {
  sensor: t('module.category.sensor'),
  display: t('module.category.display'),
  actuator: t('module.category.actuator'),
  communication: t('module.category.communication'),
  audio: t('module.category.audio'),
  power: t('module.category.power'),
  storage: t('module.category.storage'),
  lighting: t('module.category.lighting'),
  other: t('module.category.other'),
};

// 分类图标（Paper Lab 线性风）
const categoryIcons: Record<string, string> = {
  sensor: '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M12 3v3M12 18v3M3 12h3M18 12h3M5.6 5.6l2.1 2.1M16.3 16.3l2.1 2.1M18.4 5.6l-2.1 2.1M7.7 16.3l-2.1 2.1"/><circle cx="12" cy="12" r="3.2"/></svg>',
  display: '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><rect x="2" y="4" width="20" height="14" rx="2"/><path d="M8 22h8M12 18v4"/></svg>',
  actuator: '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M13 2 3 14h9l-1 8 10-12h-9l1-8Z"/></svg>',
  communication: '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M4 11a9 9 0 0 1 9 9"/><path d="M4 4a16 16 0 0 1 16 16"/><circle cx="5" cy="19" r="1"/></svg>',
  audio: '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M11 5 6 9H2v6h4l5 4V5Z"/><path d="M15.5 8.5a5 5 0 0 1 0 7M18.5 5.5a9.2 9.2 0 0 1 0 13"/></svg>',
  power: '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><rect x="2" y="7" width="16" height="10" rx="2"/><path d="M22 11v2M6 11v2"/></svg>',
  storage: '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><rect x="2" y="4" width="20" height="16" rx="2"/><path d="M2 10h20"/><circle cx="6" cy="7" r="1"/><circle cx="10" cy="7" r="1"/></svg>',
  lighting: '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M9 18h6M10 21h4M12 3a6 6 0 0 0-4 10.5c.8.7 1 1.5 1 2.5h6c0-1 .2-1.8 1-2.5A6 6 0 0 0 12 3Z"/></svg>',
  other: '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="9"/><path d="M12 16v-4M12 8h.01"/></svg>',
};

// 面包屑
interface BreadcrumbItem {
  label: string;
  href?: string;
  current?: boolean;
}

const breadcrumbItems: BreadcrumbItem[] = [
  { label: t('nav.home'), href: getLocalizedPath('/', currentLocale) },
  { label: t('nav.modules'), href: getLocalizedPath('/modules', currentLocale) },
];

if (!isListPage && module) {
  breadcrumbItems.push({ label: module.data.model, current: true });
}

// 结构化数据
let structuredData: any = null;
const siteUrl = Astro.site || 'https://lingflux.com';

if (!isListPage && module) {
  let moduleSpecs = '';
  if (module.data.specs) {
    if ('zh-cn' in module.data.specs && typeof module.data.specs['zh-cn'] === 'object') {
      const localizedSpecs = (module.data.specs as Record<string, any>)[lang] || (module.data.specs as Record<string, any>)['zh-cn'] || {};
      moduleSpecs = Object.entries(localizedSpecs).map(([k, v]) => `${k}: ${v}`).join(', ');
    } else {
      moduleSpecs = Object.entries(module.data.specs).map(([k, v]) => `${k}: ${v}`).join(', ');
    }
  }
  structuredData = {
    '@context': 'https://schema.org',
    '@type': 'Product',
    name: module.data.model,
    brand: module.data.brand ? { '@type': 'Brand', name: module.data.brand } : undefined,
    description: moduleSpecs || `${module.data.model} 模块`,
    category: module.data.category,
    image: module.data.image ? new URL(module.data.image, siteUrl).href : undefined,
  };
}

const pageDescription = !isListPage && module
  ? (() => {
      if (module.data.specs) {
        let specsEntries: [string, any][] = [];
        if ('zh-cn' in module.data.specs && typeof module.data.specs['zh-cn'] === 'object') {
          const localizedSpecs = (module.data.specs as Record<string, any>)[lang] || (module.data.specs as Record<string, any>)['zh-cn'] || {};
          specsEntries = Object.entries(localizedSpecs).slice(0, 3);
        } else {
          specsEntries = Object.entries(module.data.specs).slice(0, 3);
        }
        return specsEntries.map(([k, v]) => `${k}: ${v}`).join(', ');
      }
      return t('module.detailDescription').replace('{model}', module.data.model);
    })()
  : t('module.listDescription');

// 多语言 specs / keywords
const getLocalizedSpecs = (specs: any, locale: string): Record<string, string | number | boolean> => {
  if (!specs) return {};
  if ('zh-cn' in specs && typeof specs['zh-cn'] === 'object') {
    return specs[locale] || specs['zh-cn'] || {};
  }
  return specs;
};

const getLocalizedKeywords = (keywords: any, locale: string): string[] => {
  if (!keywords) return [];
  if (Array.isArray(keywords)) return keywords;
  return keywords[locale] || keywords['zh-cn'] || [];
};

const docIcon = '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8Z"/><path d="M14 2v6h6M8 13h8M8 17h5"/></svg>';
const boltIcon = '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M13 2 4.5 13.5H11L9.5 22 19 9.5h-6.5L13 2Z"/></svg>';
---

<Layout
  title={isListPage ? t('nav.modules') : module?.data.model}
  description={pageDescription}
  lang={lang}
  currentPath={`/${lang}/modules/${id || ''}`}
  image={!isListPage && module?.data.image ? module.data.image : undefined}
  structuredData={structuredData}
>
  <!-- ============ 列表页 ============ -->
  {isListPage && (
    <>
      <section class="page-hero">
        <div class="container">
          <Breadcrumb items={breadcrumbItems} />
          <span class="eyebrow">SPEC SHEETS · {t('nav.modules')}</span>
          <h1>{t('nav.modules')}</h1>
          <p class="lead">{t('module.listDescription')}</p>
          <p class="hero-stats">{allModules.length} {t('module.modulesCount')}</p>
        </div>
      </section>

      <section class="section">
        <div class="container">
          <!-- 分类锚点导航 -->
          <nav class="cat-nav" aria-label="Categories">
            {Object.entries(modulesByCategory).map(([category, mods]) =>
              mods.length > 0 && (
                <a class="filter-chip" href={`#${category}`}>
                  {categoryNames[category] || category} <span class="count">{mods.length}</span>
                </a>
              )
            )}
          </nav>

          <!-- 按分类分组展示 -->
          {Object.entries(modulesByCategory).map(([category, mods]) =>
            mods.length > 0 && (
              <section class="category-section" id={category}>
                <div class="category-head">
                  <span class="module-icon"><Fragment set:html={categoryIcons[category]} /></span>
                  <h2>{categoryNames[category] || category}</h2>
                  <span class="count-badge">{mods.length}</span>
                </div>
                <div class="card-grid card-grid--4">
                  {mods.map(mod => (
                    <Card
                      type="module"
                      title={mod.data.model}
                      link={getLocalizedPath(`/modules/${mod.id}`, currentLocale)}
                      image={mod.data.image}
                      brand={mod.data.brand}
                      specs={getLocalizedSpecs(mod.data.specs, lang)}
                      catLabel={categoryNames[mod.data.category] || mod.data.category}
                      locale={currentLocale}
                    />
                  ))}
                </div>
              </section>
            )
          )}
        </div>
      </section>
    </>
  )}

  <!-- ============ 详情页 ============ -->
  {!isListPage && module && (
    <main class="container">
      <div class="article-layout">
        <article class="article-body">
          <Breadcrumb items={breadcrumbItems} />

          <div class="paper-page">
            <header class="article-head">
              <div class="meta-row">
                <span class="chip chip--pen">
                  <Fragment set:html={categoryIcons[module.data.category]} />
                  {categoryNames[module.data.category]}
                </span>
                {module.data.brand && <span class="chip">{module.data.brand}</span>}
              </div>
              <h1>{module.data.model}</h1>
              {getLocalizedKeywords(module.data.keywords, lang).length > 0 && (
                <p class="intro" style="font-size:14px;">
                  <strong>{t('module.alias')}：</strong>
                  {getLocalizedKeywords(module.data.keywords, lang).join('、')}
                </p>
              )}
              <div class="detail-actions">
                {module.data.officialUrl && (
                  <AffiliateLink url={module.data.officialUrl} label={t('module.officialDocs')} type="official" variant="button" locale={currentLocale} />
                )}
                {module.data.datasheet && (
                  <AffiliateLink url={module.data.datasheet} label={t('module.datasheet')} type="official" variant="button" locale={currentLocale} />
                )}
              </div>
            </header>

            {module.data.image && (
              <div class="article-hero-img reveal">
                <span class="tape" aria-hidden="true"></span>
                <img src={module.data.image} alt={`${module.data.model} ${module.data.brand || ''}`} style="object-fit:contain; max-height:320px; margin:0 auto;" />
              </div>
            )}

            <!-- 规格参数 -->
            {Object.keys(getLocalizedSpecs(module.data.specs, lang)).length > 0 && (
              <>
                <div class="prose"><h2>{t('module.specs')}</h2></div>
                <div class="spec-grid">
                  {Object.entries(getLocalizedSpecs(module.data.specs, lang)).map(([key, value]) => (
                    <div class="spec-cell">
                      <span class="k">{key}</span>
                      <span class="v">{String(value)}</span>
                    </div>
                  ))}
                </div>
              </>
            )}

            <!-- 详细说明文档 -->
            {currentDoc && (
              <div class="prose" set:html={currentDoc.rendered?.html} />
            )}
          </div>
        </article>

        <!-- 侧边栏 -->
        <aside class="article-aside">
          <div class="aside-sticky">
            {relatedExperiments.length > 0 && (
              <div class="aside-card">
                <h4>
                  <Fragment set:html={boltIcon} />
                  {t('module.relatedExperiments')}
                  <span class="count-badge">{relatedExperiments.length}</span>
                </h4>
                <div class="link-list">
                  {relatedExperiments.slice(0, 5).map(exp => {
                    const category = exp.id.split('/')[0];
                    const expSlug = exp.id.replace('.md', '').split('/').pop();
                    return (
                      <a href={getLocalizedPath(`/experiments/${category}/${expSlug}`, currentLocale)}>
                        {exp.data.title}
                      </a>
                    );
                  })}
                </div>
              </div>
            )}

            {relatedSolutions.length > 0 && (
              <div class="aside-card">
                <h4>
                  <Fragment set:html={docIcon} />
                  {t('module.relatedSolutions')}
                  <span class="count-badge">{relatedSolutions.length}</span>
                </h4>
                <div class="link-list">
                  {relatedSolutions.slice(0, 5).map(sol => (
                    <a href={getLocalizedPath(`/solutions/${sol.id.replace(`${lang}/`, '').replace('.md', '')}`, currentLocale)}>
                      {sol.data.title}
                    </a>
                  ))}
                </div>
              </div>
            )}
          </div>
        </aside>
      </div>
    </main>
  )}

  <!-- 未找到 -->
  {!isListPage && !module && (
    <section class="not-found">
      <div class="container">
        <p class="nf-code">ERROR · 404</p>
        <h1>{t('module.notFound')}</h1>
        <a href={getLocalizedPath('/modules', currentLocale)} class="btn btn--primary">{t('module.backToList')}</a>
      </div>
    </section>
  )}
</Layout>
