---
/**
 * 基础实验 - 列表页和详情页 · Paper Lab 纸感实验室
 *
 * @route /[lang]/experiments/[...path]
 */

import Layout from '../../../layouts/Layout.astro';
import Card from '../../../components/Card.astro';
import Breadcrumb from '../../../components/Breadcrumb.astro';
import Pagination from '../../../components/Pagination.astro';
import { getCollection, getEntry } from 'astro:content';
import { useTranslations, getLocalizedPath } from '../../../utils/i18n';
import { languages } from '../../../i18n/config';
import type { SupportedLocale } from '../../../i18n/config';

export async function getStaticPaths() {
  const paths: any[] = [];
  const ITEMS_PER_PAGE = 12;

  const allExperiments = await getCollection('experiments');

  const categories = new Set<string>();
  allExperiments.forEach(({ id }) => {
    const pathParts = id.split('/');
    if (pathParts.length >= 2) {
      categories.add(pathParts[0]);
    }
  });

  for (const lang of Object.keys(languages)) {
    const experiments = allExperiments.filter(({ id }) => id.includes(`/${lang}/`));

    const totalItems = experiments.length;
    const totalPages = Math.ceil(totalItems / ITEMS_PER_PAGE) || 1;

    for (let page = 1; page <= totalPages; page++) {
      const pagePath = page === 1 ? undefined : `page/${page}`;
      paths.push({ params: { lang, path: pagePath } });
    }

    for (const category of categories) {
      const categoryExperiments = experiments.filter(({ id }) => id.startsWith(`${category}/`));
      const categoryTotalPages = Math.ceil(categoryExperiments.length / ITEMS_PER_PAGE) || 1;

      for (let page = 1; page <= categoryTotalPages; page++) {
        if (page === 1) {
          paths.push({ params: { lang, path: category } });
        } else {
          paths.push({ params: { lang, path: `${category}/page/${page}` } });
        }
      }
    }

    experiments.forEach((experiment) => {
      const pathParts = experiment.id.split('/');
      const category = pathParts[0];
      const slug = pathParts[pathParts.length - 1].replace(/\.md$/, '');
      paths.push({ params: { lang, path: `${category}/${slug}` } });
    });
  }

  return paths;
}

const { lang, path: slug } = Astro.params;
const currentLocale: SupportedLocale = lang as SupportedLocale;
const t = useTranslations(currentLocale);

const allExperiments = await getCollection('experiments', ({ id }) => {
  return id.includes(`/${lang}/`);
});
const categories = new Set<string>();
allExperiments.forEach(({ id }) => {
  const pathParts = id.split('/');
  if (pathParts.length >= 2) {
    categories.add(pathParts[0]);
  }
});

// 判断页面类型
let pageType: 'global-list' | 'category-list' | 'detail' = 'global-list';
let currentCategory = '';
let currentSlug = '';
let currentPage = 1;

if (!slug) {
  pageType = 'global-list';
} else if (slug.startsWith('page/')) {
  pageType = 'global-list';
  const pageNum = slug.replace('page/', '');
  currentPage = Number(pageNum) || 1;
} else {
  const pathParts = slug.split('/');
  if (pathParts.length === 1) {
    pageType = 'category-list';
    currentCategory = pathParts[0];
  } else if (pathParts.length === 2 && pathParts[1].startsWith('page/')) {
    pageType = 'category-list';
    currentCategory = pathParts[0];
    const pageNum = pathParts[1].replace('page/', '');
    currentPage = Number(pageNum) || 1;
  } else {
    pageType = 'detail';
    currentCategory = pathParts[0];
    currentSlug = pathParts[pathParts.length - 1];
  }
}

const ITEMS_PER_PAGE = 12;

let filteredExperiments = allExperiments;
let totalPages = 1;

if (pageType === 'category-list' && currentCategory) {
  filteredExperiments = allExperiments.filter(({ id }) => id.startsWith(`${currentCategory}/`));
}

filteredExperiments.sort((a, b) => {
  const dateA = a.data.date ? new Date(a.data.date).getTime() : 0;
  const dateB = b.data.date ? new Date(b.data.date).getTime() : 0;
  return dateB - dateA;
});

const totalItems = filteredExperiments.length;
totalPages = Math.ceil(totalItems / ITEMS_PER_PAGE) || 1;
const startIndex = (currentPage - 1) * ITEMS_PER_PAGE;
const endIndex = startIndex + ITEMS_PER_PAGE;
const currentExperiments = filteredExperiments.slice(startIndex, endIndex);

// 详情页数据
let experiment = null;
let board = null;
let modules: any[] = [];

if (pageType === 'detail' && currentCategory && currentSlug) {
  experiment = allExperiments.find(({ id }) => id.startsWith(`${currentCategory}/${lang}/`) && id.endsWith(`/${currentSlug}`));
  if (experiment) {
    if ('boardId' in experiment.data && experiment.data.boardId) {
      const boardId = (experiment.data.boardId as any).id || String(experiment.data.boardId);
      board = await getEntry('boards', boardId);
    }
    if ('moduleIds' in experiment.data && Array.isArray(experiment.data.moduleIds)) {
      modules = await Promise.all(
        experiment.data.moduleIds.map(async (modRef: any) => {
          const modId = modRef.id || String(modRef);
          return await getEntry('modules', modId);
        })
      );
    } else if ('moduleId' in experiment.data && experiment.data.moduleId) {
      const modId = (experiment.data.moduleId as any).id || String(experiment.data.moduleId);
      modules = [await getEntry('modules', modId)];
    }
    modules = modules.filter(Boolean);
  }
}

// 上一篇 / 下一篇（按日期排序的同语言实验）
let prevExp: any = null;
let nextExp: any = null;
if (pageType === 'detail' && experiment) {
  const sorted = [...allExperiments].sort((a, b) => {
    const da = a.data.date ? new Date(a.data.date).getTime() : 0;
    const db = b.data.date ? new Date(b.data.date).getTime() : 0;
    return db - da;
  });
  const idx = sorted.findIndex(e => e.id === experiment.id);
  if (idx > 0) prevExp = sorted[idx - 1];
  if (idx >= 0 && idx < sorted.length - 1) nextExp = sorted[idx + 1];
}
const expLink = (e: any) => {
  const cat = e.id.split('/')[0];
  const s = e.id.replace('.md', '').split('/').pop();
  return getLocalizedPath(`/experiments/${cat}/${s}`, currentLocale);
};

// 面包屑
const breadcrumbItems = [
  { label: t('nav.home'), href: getLocalizedPath('/', currentLocale) },
  { label: t('nav.experiments'), href: getLocalizedPath('/experiments', currentLocale) },
];

if (pageType === 'category-list' && currentCategory) {
  breadcrumbItems.push({ label: currentCategory.toUpperCase(), current: true } as any);
} else if (pageType === 'detail' && experiment && currentCategory) {
  breadcrumbItems.push({
    label: currentCategory.toUpperCase(),
    href: getLocalizedPath(`/experiments/${currentCategory}`, currentLocale)
  });
  breadcrumbItems.push({ label: experiment.data.title, current: true } as any);
}

// 结构化数据
let structuredData: any = null;
const siteUrl = Astro.site || 'https://lingflux.com';

if (pageType === 'detail' && experiment) {
  structuredData = {
    '@context': 'https://schema.org',
    '@type': 'TechArticle',
    headline: experiment.data.title,
    description: experiment.data.intro || '',
    image: experiment.data.image ? new URL(experiment.data.image, siteUrl).href : undefined,
    datePublished: experiment.data.date ? (experiment.data.date as Date).toISOString() : undefined,
    author: { '@type': 'Organization', name: 'LINGFLUX' },
    publisher: {
      '@type': 'Organization',
      name: 'LINGFLUX',
      logo: { '@type': 'ImageObject', url: new URL('/logo.png', siteUrl).href }
    }
  };
}

const pageDescription = pageType === 'detail' && experiment
  ? experiment.data.intro || '探索硬件开发的无限可能，从基础教程到高级案例，一站式学习平台'
  : (currentCategory ? t('experiments.categoryDescription').replace('{category}', currentCategory.toUpperCase()) : t('experiments.listDescription'));

const robotsMeta = currentPage > 1 ? 'noindex, follow' : undefined;

const tocIcon = '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><path d="M8 6h13M8 12h13M8 18h13M3.5 6h.01M3.5 12h.01M3.5 18h.01"/></svg>';
const boardIcon = '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"><rect x="6" y="6" width="12" height="12" rx="2"/><path d="M9 6V3M15 6V3M9 21v-3M15 21v-3M6 9H3M6 15H3M21 9h-3M21 15h-3"/></svg>';
const moduleIcon = '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M12 2 2 7l10 5 10-5-10-5Z"/><path d="m2 17 10 5 10-5M2 12l10 5 10-5"/></svg>';
const boltIcon = '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M13 2 4.5 13.5H11L9.5 22 19 9.5h-6.5L13 2Z"/></svg>';
---

<Layout
  title={pageType === 'detail' ? experiment?.data.title : (currentCategory ? `${currentCategory.toUpperCase()} - ${t('nav.experiments')}` : t('nav.experiments'))}
  description={pageDescription}
  lang={lang}
  currentPath={`/${lang}/experiments/${slug || ''}`}
  image={pageType === 'detail' && experiment?.data.image ? experiment.data.image : undefined}
  robots={robotsMeta}
  structuredData={structuredData}
>
  <!-- ============ 列表页 ============ -->
  {pageType !== 'detail' && (
    <>
      <section class="page-hero">
        <div class="container">
          <Breadcrumb items={breadcrumbItems} />
          <span class="eyebrow">LAB NOTES · {t('nav.experiments')}</span>
          <h1>{currentCategory ? currentCategory.toUpperCase() : t('nav.experiments')}</h1>
          <p class="lead">
            {currentCategory ? t('experiments.categoryDescription').replace('{category}', currentCategory.toUpperCase()) : t('experiments.listDescription')}
          </p>
          <p class="hero-stats">
            {startIndex + 1}–{Math.min(endIndex, totalItems)} / {t('experiments.totalItems').replace('{count}', String(totalItems))}
          </p>
        </div>
      </section>

      <section class="section">
        <div class="container">
          <!-- 分类锚点导航 -->
          <nav class="filter-bar" aria-label="Categories">
            <a
              class={`filter-chip ${!currentCategory ? 'active' : ''}`}
              href={getLocalizedPath('/experiments', currentLocale)}
            >
              {t('board.all')} <span class="count">{allExperiments.length}</span>
            </a>
            {Array.from(categories).map(cat => (
              <a
                class={`filter-chip ${currentCategory === cat ? 'active' : ''}`}
                href={getLocalizedPath(`/experiments/${cat}`, currentLocale)}
              >
                {cat.toUpperCase()}
                <span class="count">{allExperiments.filter(e => e.id.startsWith(`${cat}/`)).length}</span>
              </a>
            ))}
          </nav>

          <div class="card-grid">
            {currentExperiments.map((exp, i) => {
              const category = exp.id.split('/')[0];
              const expSlug = exp.id.replace('.md', '').split('/').pop();
              return (
                <Card
                  type="article"
                  title={exp.data.title}
                  description={exp.data.intro}
                  link={getLocalizedPath(`/experiments/${category}/${expSlug}`, currentLocale)}
                  tags={[category.toUpperCase()]}
                  hideFloatTag={true}
                  date={('date' in exp.data ? exp.data.date as Date : undefined)}
                  image={exp.data.image}
                  locale={currentLocale}
                />
              );
            })}
          </div>

          <Pagination
            currentPage={currentPage}
            totalPages={totalPages}
            baseUrl={currentCategory ? getLocalizedPath(`/experiments/${currentCategory}`, currentLocale) : getLocalizedPath('/experiments', currentLocale)}
            getUrl={(page) => currentCategory
              ? getLocalizedPath(page === 1 ? `/experiments/${currentCategory}` : `/experiments/${currentCategory}/page/${page}`, currentLocale)
              : getLocalizedPath(page === 1 ? '/experiments' : `/experiments/page/${page}`, currentLocale)}
          />
        </div>
      </section>
    </>
  )}

  <!-- ============ 详情页 ============ -->
  {pageType === 'detail' && experiment && (
    <main class="container">
      <div class="article-layout">
        <article class="article-body">
          <Breadcrumb items={breadcrumbItems} />

          <div class="paper-page">
            <header class="article-head">
              <div class="meta-row">
                <span class="chip chip--accent">{t('experiments.tutorial')}</span>
                {board && (
                  <a class="chip" href={getLocalizedPath(`/boards/${board.id}`, currentLocale)}>
                    <Fragment set:html={boardIcon} />
                    {board.data.brand} {board.data.model}
                  </a>
                )}
                {modules.map((mod: any) => (
                  <a class="chip" href={getLocalizedPath(`/modules/${mod.id}`, currentLocale)}>
                    <Fragment set:html={moduleIcon} />
                    {mod.data.model}
                  </a>
                ))}
              </div>
              <h1>{experiment.data.title}</h1>
              {experiment.data.intro && <p class="intro">{experiment.data.intro}</p>}
              {experiment.data.date && (
                <div class="byline">
                  <time datetime={(experiment.data.date as Date).toISOString()}>
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><rect x="3" y="4" width="18" height="18" rx="2"/><path d="M16 2v4M8 2v4M3 10h18"/></svg>
                    {(experiment.data.date as Date).toISOString().slice(0, 10)}
                  </time>
                  <span class="chip chip--green">VERIFIED ✓</span>
                </div>
              )}
            </header>

            {experiment.data.image && (
              <div class="article-hero-img reveal">
                <span class="tape" aria-hidden="true"></span>
                <img src={experiment.data.image} alt={experiment.data.title} />
              </div>
            )}

            <!-- 移动端目录（JS 自动填充） -->
            <nav class="toc-mobile">
              <details>
                <summary>
                  <Fragment set:html={tocIcon} />
                  INDEX · {t('ui.toc')}
                  <svg class="chev" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="m6 9 6 6 6-6"/></svg>
                </summary>
                <div class="toc" data-toc></div>
              </details>
            </nav>

            <div class="prose" data-in-article-ads set:html={experiment.rendered?.html} />

            <!-- 上一篇 / 下一篇 -->
            <nav class="pager-nav" aria-label="More experiments">
              {prevExp ? (
                <a href={expLink(prevExp)} class="prev">
                  <span class="dir">← PREV</span>
                  <span class="t">{prevExp.data.title}</span>
                </a>
              ) : <span></span>}
              {nextExp ? (
                <a href={expLink(nextExp)} class="next">
                  <span class="dir">NEXT →</span>
                  <span class="t">{nextExp.data.title}</span>
                </a>
              ) : <span></span>}
            </nav>
          </div>
        </article>

        <!-- 侧边栏 -->
        <aside class="article-aside">
          <div class="aside-sticky">
            <div class="aside-card">
              <h4><Fragment set:html={tocIcon} />INDEX · {t('ui.toc')}</h4>
              <nav class="toc" data-toc aria-label={t('ui.toc')}></nav>
            </div>

            {(board || modules.length > 0) && (
              <div class="aside-card">
                <h4><Fragment set:html={boardIcon} />PARTS · {t('ui.related')}</h4>
                {board && (
                  <a class="hw-card" href={getLocalizedPath(`/boards/${board.id}`, currentLocale)}>
                    <span class="module-icon"><Fragment set:html={boardIcon} /></span>
                    <span>
                      <span class="n">{board.data.model}</span><br />
                      <span class="r">{t('nav.boards')} · {board.data.brand}</span>
                    </span>
                  </a>
                )}
                {modules.map((mod: any) => (
                  <a class="hw-card" href={getLocalizedPath(`/modules/${mod.id}`, currentLocale)}>
                    <span class="module-icon"><Fragment set:html={moduleIcon} /></span>
                    <span>
                      <span class="n">{mod.data.model}</span><br />
                      <span class="r">{t('nav.modules')}{mod.data.brand ? ` · ${mod.data.brand}` : ''}</span>
                    </span>
                  </a>
                ))}
              </div>
            )}

            <div class="aside-card">
              <h4><Fragment set:html={boltIcon} />RELATED · {t('experiments.related')}</h4>
              <div class="link-list">
                {allExperiments
                  .filter(e => e.id !== experiment?.id)
                  .slice(0, 5)
                  .map(related => (
                    <a href={expLink(related)}>{related.data.title}</a>
                  ))}
              </div>
            </div>
          </div>
        </aside>
      </div>
    </main>
  )}

  <!-- 未找到 -->
  {pageType === 'detail' && !experiment && (
    <section class="not-found">
      <div class="container">
        <p class="nf-code">ERROR · 404</p>
        <h1>{t('experiments.notFound')}</h1>
        <a href={getLocalizedPath('/experiments', currentLocale)} class="btn btn--primary">{t('experiments.backToList')}</a>
      </div>
    </section>
  )}
</Layout>
