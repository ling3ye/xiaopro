---
/**
 * 3D模型 - 列表页和详情页 · Paper Lab 纸感实验室
 *
 * @route /[lang]/printing/models/[...path]
 */

import Layout from '../../../../layouts/Layout.astro';
import Card from '../../../../components/Card.astro';
import Breadcrumb from '../../../../components/Breadcrumb.astro';
import AffiliateLink from '../../../../components/AffiliateLink.astro';
import { getCollection, getEntry } from 'astro:content';
import { useTranslations, getLocalizedPath } from '../../../../utils/i18n';
import { languages } from '../../../../i18n/config';
import type { SupportedLocale } from '../../../../i18n/config';

export async function getStaticPaths() {
  const paths: any[] = [];

  for (const lang of Object.keys(languages)) {
    paths.push({ params: { lang, path: undefined } });
    const models = await getCollection('models', ({ id }) => id.startsWith(`${lang}/`));
    models.forEach((model) => {
      const slug = model.id.split('/').pop()?.replace('.md', '') || '';
      paths.push({ params: { lang, path: slug } });
    });
  }
  return paths;
}

const { lang, path: slug } = Astro.params;
const currentLocale: SupportedLocale = lang as SupportedLocale;
const t = useTranslations(currentLocale);
const isListPage = !slug;

const allModels = await getCollection('models', ({ id }) => id.startsWith(`${lang}/`));

// 详情页数据
let model: any = null;
let relatedSolutions: any[] = [];
let relatedPrinters: any[] = [];
let relatedFilaments: any[] = [];

if (!isListPage) {
  const entry = await getEntry('models', `${lang}/${slug}`);
  if (entry) {
    model = entry;

    if ('relatedSolutions' in model.data && Array.isArray(model.data.relatedSolutions)) {
      relatedSolutions = await Promise.all(
        model.data.relatedSolutions.map(async (ref: any) => {
          const solId = ref.id || String(ref);
          return getEntry('solutions', solId);
        })
      );
      relatedSolutions = relatedSolutions.filter(Boolean);
    }

    if ('relatedPrinters' in model.data && Array.isArray(model.data.relatedPrinters)) {
      relatedPrinters = await Promise.all(
        model.data.relatedPrinters.map(async (ref: any) => {
          const pId = ref.id || String(ref);
          return getEntry('printers', pId);
        })
      );
      relatedPrinters = relatedPrinters.filter(Boolean);
    }

    if ('relatedFilaments' in model.data && Array.isArray(model.data.relatedFilaments)) {
      relatedFilaments = await Promise.all(
        model.data.relatedFilaments.map(async (ref: any) => {
          const fId = ref.id || String(ref);
          return getEntry('filaments', fId);
        })
      );
      relatedFilaments = relatedFilaments.filter(Boolean);
    }
  }
}

// 分类配置
const categoryNames: Record<string, string> = {
  utility: t('model.category.utility'),
  electronics: t('model.category.electronics'),
  home: t('model.category.home'),
  toy: t('model.category.toy'),
  tool: t('model.category.tool'),
  other: t('model.category.other'),
};

const categoryIcons: Record<string, string> = {
  utility: '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M14.7 6.3a1 1 0 0 0 0 1.4l1.6 1.6a1 1 0 0 0 1.4 0l3.77-3.77a6 6 0 0 1-7.94 7.94l-6.91 6.91a2.12 2.12 0 0 1-3-3l6.91-6.91a6 6 0 0 1 7.94-7.94l-3.76 3.76z"/></svg>',
  electronics: '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"><rect x="6" y="6" width="12" height="12" rx="2"/><path d="M9 6V3M15 6V3M9 21v-3M15 21v-3M6 9H3M6 15H3M21 9h-3M21 15h-3"/></svg>',
  home: '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="m3 10 9-7 9 7v10a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2Z"/><path d="M9 22V12h6v10"/></svg>',
  toy: '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="9"/><path d="M8.5 9h.01M15.5 9h.01M8 14.5s1.5 2 4 2 4-2 4-2"/></svg>',
  tool: '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M4 17l6-6-4-4-2 2 4 4-4 4z"/><path d="M14 4l6 6-8 8H6v-6z"/></svg>',
  other: '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="9"/><path d="M12 16v-4M12 8h.01"/></svg>',
};

// 按分类分组
const modelCategories = ['utility', 'electronics', 'home', 'toy', 'tool', 'other'] as const;
const modelsByCategory: Record<string, typeof allModels> = {};
modelCategories.forEach(cat => {
  modelsByCategory[cat] = allModels.filter(m => (m.data.category || 'other') === cat);
});

// 面包屑
const breadcrumbItems: any[] = [
  { label: t('nav.home'), href: getLocalizedPath('/', currentLocale) },
  { label: t('nav.printing'), href: getLocalizedPath('/printing', currentLocale) },
  { label: t('printing.models'), href: getLocalizedPath('/printing/models', currentLocale) },
];
if (!isListPage && model) {
  breadcrumbItems.push({ label: model.data.title, current: true });
}

// 结构化数据
let structuredData: any = null;
if (!isListPage && model) {
  structuredData = {
    '@context': 'https://schema.org',
    '@type': 'CreativeWork',
    name: model.data.title,
    description: model.data.description || '',
    image: model.data.image,
  };
}

const pageDescription = !isListPage && model
  ? model.data.description || t('model.listDescription')
  : t('model.listDescription');

const tocIcon = '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><path d="M8 6h13M8 12h13M8 18h13M3.5 6h.01M3.5 12h.01M3.5 18h.01"/></svg>';
const printerIcon = '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M6 9V2h12v7M6 18H4a2 2 0 0 1-2-2v-5a2 2 0 0 1 2-2h16a2 2 0 0 1 2 2v5a2 2 0 0 1-2 2h-2"/><rect x="6" y="14" width="12" height="8" rx="1"/></svg>';
const filamentIcon = '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="9"/><circle cx="12" cy="12" r="3"/><path d="M12 3v3M12 18v3M3 12h3M18 12h3"/></svg>';
const boltIcon = '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M13 2 4.5 13.5H11L9.5 22 19 9.5h-6.5L13 2Z"/></svg>';
---

<Layout
  title={isListPage ? `${t('printing.models')} - ${t('printing.title')}` : model?.data.title}
  description={pageDescription}
  lang={lang}
  currentPath={`/${lang}/printing/models/${slug || ''}`}
  image={!isListPage && model?.data.image ? model.data.image : undefined}
  structuredData={structuredData}
>
  <!-- ============ 列表页 ============ -->
  {isListPage && (
    <>
      <section class="page-hero">
        <div class="container">
          <Breadcrumb items={breadcrumbItems} />
          <span class="eyebrow">BLUEPRINTS · {t('printing.models')}</span>
          <h1>{t('printing.models')}</h1>
          <p class="lead">{t('model.listDescription')}</p>
          <p class="hero-stats">{allModels.length} MODELS</p>
        </div>
      </section>

      <section class="section">
        <div class="container">
          <!-- 分类锚点导航 -->
          <nav class="cat-nav" aria-label="Categories">
            {modelCategories.map(cat => modelsByCategory[cat].length > 0 && (
              <a class="filter-chip" href={`#${cat}`}>
                {categoryNames[cat]} <span class="count">{modelsByCategory[cat].length}</span>
              </a>
            ))}
          </nav>

          {modelCategories.map(cat => modelsByCategory[cat].length > 0 && (
            <section class="category-section" id={cat}>
              <div class="category-head">
                <span class="module-icon"><Fragment set:html={categoryIcons[cat]} /></span>
                <h2>{categoryNames[cat] || cat}</h2>
                <span class="count-badge">{modelsByCategory[cat].length}</span>
              </div>
              <div class="card-grid card-grid--4">
                {modelsByCategory[cat].map(m => {
                  const mSlug = m.id.split('/').pop()?.replace('.md', '') || '';
                  return (
                    <Card
                      type="model"
                      title={m.data.title}
                      description={m.data.description}
                      link={getLocalizedPath(`/printing/models/${mSlug}`, currentLocale)}
                      image={m.data.image}
                      tags={m.data.tags}
                      date={m.data.date}
                      locale={currentLocale}
                    />
                  );
                })}
              </div>
            </section>
          ))}
        </div>
      </section>
    </>
  )}

  <!-- ============ 详情页 ============ -->
  {!isListPage && model && (
    <main class="container">
      <div class="article-layout">
        <article class="article-body">
          <Breadcrumb items={breadcrumbItems} />

          <div class="paper-page">
            <header class="article-head">
              <div class="meta-row">
                {model.data.category && (
                  <span class="chip chip--accent">
                    <Fragment set:html={categoryIcons[model.data.category] || categoryIcons.other} />
                    {categoryNames[model.data.category] || model.data.category}
                  </span>
                )}
                {model.data.date && (
                  <span class="chip">{(model.data.date as Date).toISOString().slice(0, 10)}</span>
                )}
              </div>
              <h1>{model.data.title}</h1>
              {model.data.description && <p class="intro">{model.data.description}</p>}
              {model.data.tags && model.data.tags.length > 0 && (
                <div class="tag-row">
                  {model.data.tags.map((tag: string) => <span class="chip">{tag}</span>)}
                </div>
              )}
              {model.data.makerWorldUrl && (
                <div class="detail-actions">
                  <AffiliateLink url={model.data.makerWorldUrl} label={t('model.makerWorld')} type="makerworld" variant="button" locale={currentLocale} />
                  <span class="hero-note">{t('model.makerWorldTip')}</span>
                </div>
              )}
            </header>

            {model.data.image && (
              <div class="article-hero-img reveal">
                <span class="tape" aria-hidden="true"></span>
                <img src={model.data.image} alt={model.data.title} />
              </div>
            )}

            <!-- 打印设置 -->
            {model.data.printSettings && (
              <>
                <div class="prose"><h2>{t('model.printSettings')}</h2></div>
                <div class="print-settings">
                  {model.data.printSettings.material && (
                    <div class="spec-cell"><span class="k">{t('model.material')}</span><span class="v">{model.data.printSettings.material}</span></div>
                  )}
                  {model.data.printSettings.infill && (
                    <div class="spec-cell"><span class="k">{t('model.infill')}</span><span class="v">{model.data.printSettings.infill}</span></div>
                  )}
                  {model.data.printSettings.supports && (
                    <div class="spec-cell"><span class="k">{t('model.supports')}</span><span class="v">{model.data.printSettings.supports}</span></div>
                  )}
                  {model.data.printSettings.layerHeight && (
                    <div class="spec-cell"><span class="k">{t('model.layerHeight')}</span><span class="v">{model.data.printSettings.layerHeight}</span></div>
                  )}
                  {model.data.printSettings.estimatedTime && (
                    <div class="spec-cell"><span class="k">{t('model.estimatedTime')}</span><span class="v">{model.data.printSettings.estimatedTime}</span></div>
                  )}
                </div>
              </>
            )}

            <!-- 移动端目录（JS 自动填充） -->
            <nav class="toc-mobile">
              <details>
                <summary>
                  <Fragment set:html={tocIcon} />
                  INDEX · {t('ui.toc')}
                  <svg class="chev" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="m6 9 6 6 6-6"/></svg>
                </summary>
                <div class="toc" data-toc></div>
              </details>
            </nav>

            <!-- 模型正文 -->
            <div class="prose" set:html={model.rendered?.html} />
          </div>
        </article>

        <!-- 侧边栏 -->
        <aside class="article-aside">
          <div class="aside-sticky">
            <div class="aside-card">
              <h4><Fragment set:html={tocIcon} />INDEX · {t('ui.toc')}</h4>
              <nav class="toc" data-toc aria-label={t('ui.toc')}></nav>
            </div>

            {relatedSolutions.length > 0 && (
              <div class="aside-card">
                <h4>
                  <Fragment set:html={boltIcon} />
                  {t('model.relatedSolutions')}
                  <span class="count-badge">{relatedSolutions.length}</span>
                </h4>
                <div class="link-list">
                  {relatedSolutions.map((sol: any) => (
                    <a href={getLocalizedPath(`/solutions/${sol.id.replace(`${lang}/`, '').replace('.md', '')}`, currentLocale)}>
                      {sol.data.title}
                    </a>
                  ))}
                </div>
              </div>
            )}

            {relatedPrinters.length > 0 && (
              <div class="aside-card">
                <h4><Fragment set:html={printerIcon} />{t('model.relatedPrinters')}</h4>
                {relatedPrinters.map((p: any) => (
                  <a class="hw-card" href={getLocalizedPath(`/printing/printers/${p.id}`, currentLocale)}>
                    <span class="module-icon"><Fragment set:html={printerIcon} /></span>
                    <span>
                      <span class="n">{p.data.model}</span><br />
                      <span class="r">{p.data.brand}</span>
                    </span>
                  </a>
                ))}
              </div>
            )}

            {relatedFilaments.length > 0 && (
              <div class="aside-card">
                <h4><Fragment set:html={filamentIcon} />{t('model.relatedFilaments')}</h4>
                {relatedFilaments.map((f: any) => (
                  <a class="hw-card" href={getLocalizedPath(`/printing/filaments/${f.id}`, currentLocale)}>
                    <span class="module-icon"><Fragment set:html={filamentIcon} /></span>
                    <span>
                      <span class="n">{f.data.model}</span><br />
                      <span class="r">{f.data.brand || ''}</span>
                    </span>
                  </a>
                ))}
              </div>
            )}
          </div>
        </aside>
      </div>
    </main>
  )}

  <!-- 未找到 -->
  {!isListPage && !model && (
    <section class="not-found">
      <div class="container">
        <p class="nf-code">ERROR · 404</p>
        <h1>{t('model.notFound')}</h1>
        <a href={getLocalizedPath('/printing/models', currentLocale)} class="btn btn--primary">{t('model.backToList')}</a>
      </div>
    </section>
  )}
</Layout>
