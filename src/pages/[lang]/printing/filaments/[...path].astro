---
/**
 * 3D打印耗材 - 列表页和详情页 · Paper Lab 纸感实验室
 *
 * @route /[lang]/printing/filaments/[...path]
 */

import Layout from '../../../../layouts/Layout.astro';
import Card from '../../../../components/Card.astro';
import Breadcrumb from '../../../../components/Breadcrumb.astro';
import CompareWidget from '../../../../components/CompareWidget.astro';
import AffiliateLink from '../../../../components/AffiliateLink.astro';
import { getCollection, getEntry } from 'astro:content';
import { useTranslations, getLocalizedPath } from '../../../../utils/i18n';
import { languages } from '../../../../i18n/config';
import type { SupportedLocale } from '../../../../i18n/config';
import { buildCardSpecs, getGroupedProperties, getDisplayValue, getSpecLabel, getTopProperties } from '../../../../content/filaments/spec-utils';

export async function getStaticPaths() {
  const paths: any[] = [];
  const filaments = await getCollection('filaments');

  for (const lang of Object.keys(languages)) {
    paths.push({ params: { lang, path: undefined } });
    filaments.forEach((filament) => {
      paths.push({ params: { lang, path: filament.id } });
    });
  }
  return paths;
}

const { lang, path: id } = Astro.params;
const currentLocale: SupportedLocale = lang as SupportedLocale;
const t = useTranslations(currentLocale);
const isListPage = !id;

const allFilaments = await getCollection('filaments');

let filament: any = null;
let relatedModels: any[] = [];

if (!isListPage) {
  filament = await getEntry('filaments', id);
  if (filament) {
    relatedModels = await getCollection('models', (entry) => {
      return 'relatedFilaments' in entry.data &&
        Array.isArray(entry.data.relatedFilaments) &&
        entry.data.relatedFilaments.some((ref: any) => (ref.id || String(ref)) === id) &&
        entry.id.startsWith(`${lang}/`);
    });
  }
}

// 按分类分组
const categories = ['pla', 'petg', 'abs', 'tpu', 'nylon', 'pc', 'asa', 'other'] as const;
const filamentsByCategory: Record<string, typeof allFilaments> = {};
categories.forEach(cat => {
  filamentsByCategory[cat] = allFilaments.filter(f => f.data.category === cat);
});

const categoryNames: Record<string, string> = {
  pla: t('filament.category.pla'),
  petg: t('filament.category.petg'),
  abs: t('filament.category.abs'),
  tpu: t('filament.category.tpu'),
  nylon: t('filament.category.nylon'),
  pc: t('filament.category.pc'),
  asa: t('filament.category.asa'),
  other: t('filament.category.other'),
};

const categoryIcons: Record<string, string> = {
  pla: '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="9"/><circle cx="12" cy="12" r="3"/><path d="M12 3v3M12 18v3M3 12h3M18 12h3"/></svg>',
  petg: '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M12 2 2 7l10 5 10-5-10-5Z"/><path d="m2 17 10 5 10-5"/></svg>',
  abs: '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="3" width="18" height="18" rx="2"/><path d="M3 9h18"/></svg>',
  tpu: '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="9"/><path d="M8 12h8"/></svg>',
  nylon: '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M13 2 3 14h9l-1 8 10-12h-9l1-8Z"/></svg>',
  pc: '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8Z"/><path d="M14 2v6h6"/></svg>',
  asa: '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="4"/><path d="M12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4"/></svg>',
  other: '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="9"/><path d="M12 16v-4M12 8h.01"/></svg>',
};

const breadcrumbItems: any[] = [
  { label: t('nav.home'), href: getLocalizedPath('/', currentLocale) },
  { label: t('nav.printing'), href: getLocalizedPath('/printing', currentLocale) },
  { label: t('printing.filaments'), href: getLocalizedPath('/printing/filaments', currentLocale) },
];
if (!isListPage && filament) {
  breadcrumbItems.push({ label: filament.data.model, current: true });
}

// 列表页注入对比数据
const propertiesJson = isListPage
  ? JSON.stringify(Object.fromEntries(allFilaments.map(f => [f.id, f.data.properties || {}])))
  : '{}';

const pageDescription = !isListPage && filament
  ? (() => {
      const props = filament.data.properties || {};
      const topIds = getTopProperties(props, 3);
      return topIds.map(id => `${getSpecLabel(id, currentLocale)}: ${getDisplayValue(props[id], currentLocale)}`).join(', ');
    })()
  : t('filament.listDescription');

const modelIcon = '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M21 8 12 3 3 8v8l9 5 9-5V8Z"/><path d="M3 8l9 5 9-5M12 13v8"/></svg>';
---

<Layout
  title={isListPage ? `${t('printing.filaments')} - ${t('printing.title')}` : filament?.data.model}
  description={pageDescription}
  lang={lang}
  currentPath={`/${lang}/printing/filaments/${id || ''}`}
>
  <!-- ============ 列表页 ============ -->
  {isListPage && (
    <>
      <section class="page-hero">
        <div class="container">
          <Breadcrumb items={breadcrumbItems} />
          <span class="eyebrow">LAB DATA · {t('printing.filaments')}</span>
          <h1>{t('printing.filaments')}</h1>
          <p class="lead">{t('filament.listDescription')}</p>
          <p class="hero-stats">{allFilaments.length} FILAMENTS · {t('compare.selectHint')}</p>
        </div>
      </section>

      <section class="section">
        <div class="container">
          <!-- 分类锚点导航 -->
          <nav class="cat-nav" aria-label="Categories">
            {categories.map(cat => filamentsByCategory[cat].length > 0 && (
              <a class="filter-chip" href={`#${cat}`}>
                {categoryNames[cat]} <span class="count">{filamentsByCategory[cat].length}</span>
              </a>
            ))}
          </nav>

          {categories.map(cat => filamentsByCategory[cat].length > 0 && (
            <section class="category-section" id={cat}>
              <div class="category-head">
                <span class="module-icon"><Fragment set:html={categoryIcons[cat]} /></span>
                <h2>{categoryNames[cat] || cat}</h2>
                <span class="count-badge">{filamentsByCategory[cat].length}</span>
              </div>
              <div class="card-grid card-grid--4">
                {filamentsByCategory[cat].map(f => {
                  const cardSpecs = f.data.properties
                    ? buildCardSpecs(f.data.properties, currentLocale, 3)
                    : {};
                  return (
                    <div class="compare-item" data-compare-id={f.id}>
                      <label class="compare-check">
                        <input type="checkbox" class="compare-checkbox" data-compare-id={f.id} />
                        {t('compare.addToCompare')}
                      </label>
                      <Card
                        type="filament"
                        title={f.data.model}
                        link={getLocalizedPath(`/printing/filaments/${f.id}`, currentLocale)}
                        image={f.data.image}
                        brand={f.data.brand}
                        specs={cardSpecs}
                        priceRange={f.data.priceRange}
                        catLabel={categoryNames[cat]}
                        locale={currentLocale}
                      />
                      <span class="compare-item-name">{f.data.brand || ''} {f.data.model}</span>
                    </div>
                  );
                })}
              </div>
            </section>
          ))}
        </div>
      </section>

      <script is:inline set:html={`window.__compareSpecsData = Object.assign(window.__compareSpecsData || {}, ${propertiesJson});`} />
      <CompareWidget collectionType="filaments" locale={currentLocale} />
    </>
  )}

  <!-- ============ 详情页 ============ -->
  {!isListPage && filament && (() => {
    const props = filament.data.properties || {};
    const grouped = getGroupedProperties(props, currentLocale);
    return (
      <main class="container">
        <div class="article-layout">
          <article class="article-body">
            <Breadcrumb items={breadcrumbItems} />

            <div class="paper-page">
              <header class="article-head">
                <div class="meta-row">
                  <span class="chip chip--pen">
                    <Fragment set:html={categoryIcons[filament.data.category]} />
                    {categoryNames[filament.data.category]}
                  </span>
                  {filament.data.brand && <span class="chip">{filament.data.brand}</span>}
                  {filament.data.priceRange && <span class="chip chip--green">{filament.data.priceRange}</span>}
                </div>
                <h1>{filament.data.model}</h1>
                <div class="detail-actions">
                  {filament.data.officialUrl && (
                    <AffiliateLink url={filament.data.officialUrl} label={t('filament.officialDocs')} type="official" variant="button" locale={currentLocale} />
                  )}
                  {filament.data.affiliateUrl && (
                    <AffiliateLink url={filament.data.affiliateUrl} label={t('filament.buyNow')} type="affiliate" variant="button" locale={currentLocale} />
                  )}
                  {filament.data.datasheet && (
                    <AffiliateLink url={filament.data.datasheet} label={t('filament.datasheet')} type="official" variant="button" locale={currentLocale} />
                  )}
                  <button
                    id="detail-add-compare"
                    class="btn btn--ghost"
                    type="button"
                    data-item-id={id}
                    data-item-name={`${filament.data.brand || ''} ${filament.data.model}`}
                    data-item-specs={JSON.stringify(props)}
                  >
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="3" y="3" width="7" height="18"/><rect x="14" y="3" width="7" height="18"/></svg>
                    {t('compare.addToCompare')}
                  </button>
                </div>
              </header>

              {filament.data.image && (
                <div class="article-hero-img reveal">
                  <span class="tape" aria-hidden="true"></span>
                  <img src={filament.data.image} alt={filament.data.model} style="object-fit:contain; max-height:280px; margin:0 auto;" />
                </div>
              )}

              <!-- 分组规格参数 -->
              {grouped.map(group => (
                <div class="spec-group">
                  <h3>{group.label}</h3>
                  <div class="spec-grid">
                    {group.properties.map(({ id: specId, prop }) => (
                      <div class="spec-cell">
                        <span class="k">{getSpecLabel(specId, currentLocale)}</span>
                        <span class="v">
                          {getDisplayValue(prop, currentLocale)}
                          {prop.standard && <span class="spec-note" title={prop.standard}>📋 {prop.standard}</span>}
                        </span>
                      </div>
                    ))}
                  </div>
                </div>
              ))}
            </div>
          </article>

          <!-- 侧边栏 -->
          <aside class="article-aside">
            <div class="aside-sticky">
              {relatedModels.length > 0 && (
                <div class="aside-card">
                  <h4>
                    <Fragment set:html={modelIcon} />
                    {t('filament.relatedModels')}
                    <span class="count-badge">{relatedModels.length}</span>
                  </h4>
                  <div class="link-list">
                    {relatedModels.slice(0, 5).map(model => {
                      const modelSlug = model.id.split('/').pop()?.replace('.md', '') || '';
                      return (
                        <a href={getLocalizedPath(`/printing/models/${modelSlug}`, currentLocale)}>
                          {model.data.title}
                        </a>
                      );
                    })}
                  </div>
                </div>
              )}
            </div>
          </aside>
        </div>

        <CompareWidget collectionType="filaments" locale={currentLocale} />
      </main>
    );
  })()}

  <!-- 未找到 -->
  {!isListPage && !filament && (
    <section class="not-found">
      <div class="container">
        <p class="nf-code">ERROR · 404</p>
        <h1>{t('filament.notFound')}</h1>
        <a href={getLocalizedPath('/printing/filaments', currentLocale)} class="btn btn--primary">{t('filament.backToList')}</a>
      </div>
    </section>
  )}
</Layout>
