---
/**
 * 耗材参数对比 - 独立页面 · Paper Lab 纸感实验室
 *
 * URL 格式: /printing/filaments/compare?item1=xxx&item2=xxx
 *
 * @route /[lang]/printing/filaments/compare
 */

import Layout from '../../../../layouts/Layout.astro';
import Breadcrumb from '../../../../components/Breadcrumb.astro';
import { getCollection } from 'astro:content';
import { useTranslations, getLocalizedPath } from '../../../../utils/i18n';
import { languages } from '../../../../i18n/config';
import type { SupportedLocale } from '../../../../i18n/config';
import { specLabels } from '../../../../content/filaments/spec-labels';
import { specPropertyMeta } from '../../../../content/filaments/spec-registry';

export async function getStaticPaths() {
  return Object.keys(languages).map(lang => ({ params: { lang } }));
}

const { lang } = Astro.params;
const currentLocale: SupportedLocale = lang as SupportedLocale;
const t = useTranslations(currentLocale);

const allFilaments = await getCollection('filaments');

const categoryNames: Record<string, string> = {
  pla: t('filament.category.pla'),
  petg: t('filament.category.petg'),
  abs: t('filament.category.abs'),
  tpu: t('filament.category.tpu'),
  nylon: t('filament.category.nylon'),
  pc: t('filament.category.pc'),
  asa: t('filament.category.asa'),
  other: t('filament.category.other'),
};

// Build data for client-side: id -> { name, brand, model, category, priceRange, image, link, properties }
const allData = JSON.stringify(Object.fromEntries(
  allFilaments.map(f => [f.id, {
    name: `${f.data.brand || ''} ${f.data.model}`.trim(),
    brand: f.data.brand || '',
    model: f.data.model,
    category: categoryNames[f.data.category] || f.data.category,
    priceRange: f.data.priceRange || '',
    image: f.data.image || '',
    link: getLocalizedPath(`/printing/filaments/${f.id}`, currentLocale),
    properties: f.data.properties || {},
  }])
));

// Spec labels for client-side rendering
const labelsForJs: Record<string, string> = {};
for (const [id, localeMap] of Object.entries(specLabels)) {
  labelsForJs[id] = localeMap[currentLocale] || localeMap['en'] || id;
}

// Spec meta for client-side comparison logic
const metaForJs: Record<string, { comparable: boolean; highlightDirection: string }> = {};
for (const [id, meta] of Object.entries(specPropertyMeta)) {
  metaForJs[id] = {
    comparable: meta.comparable,
    highlightDirection: meta.highlightDirection,
  };
}

const specLabelsJson = JSON.stringify(labelsForJs);
const specMetaJson = JSON.stringify(metaForJs);

const breadcrumbItems = [
  { label: t('nav.home'), href: getLocalizedPath('/', currentLocale) },
  { label: t('nav.printing'), href: getLocalizedPath('/printing', currentLocale) },
  { label: t('printing.filaments'), href: getLocalizedPath('/printing/filaments', currentLocale) },
  { label: t('compare.title'), current: true },
];
---

<Layout
  title={`${t('compare.title')} - ${t('printing.filaments')}`}
  description={t('filament.listDescription')}
  lang={lang}
  currentPath={`/${lang}/printing/filaments/compare`}
>
  <section class="page-hero">
    <div class="container">
      <Breadcrumb items={breadcrumbItems} />
      <span class="eyebrow">SIDE BY SIDE · {t('compare.title')}</span>
      <h1>{t('compare.title')} · {t('printing.filaments')}</h1>
      <p class="lead">{t('filament.listDescription')}</p>
    </div>
  </section>

  <section class="section cmp-page">
    <div class="container">
      <div id="compare-content" class="compare-content">
        <p class="cmp-empty">{t('compare.selectHint')}</p>
      </div>
      <div style="margin-top: 30px;">
        <a href={getLocalizedPath('/printing/filaments', currentLocale)} class="btn btn--ghost">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M19 12H5M12 19l-7-7 7-7"/></svg>
          {t('filament.backToList')}
        </a>
      </div>
    </div>
  </section>
</Layout>

<script define:vars={{ allData, specLabels: specLabelsJson, specMeta: specMetaJson }}>
  function renderCompare() {
    var params = new URLSearchParams(window.location.search);
    var ids = [];
    for (var pair of params) {
      if (pair[0].startsWith('item') && pair[1]) ids.push(decodeURIComponent(pair[1]));
    }

    var container = document.getElementById('compare-content');
    if (!container || ids.length < 2) return;

    var data = typeof allData === 'string' ? JSON.parse(allData) : allData;
    var labels = typeof specLabels === 'string' ? JSON.parse(specLabels) : specLabels;
    var meta = typeof specMeta === 'string' ? JSON.parse(specMeta) : specMeta;
    var items = ids.map(function(id) { return data[id]; }).filter(Boolean);

    if (items.length < 2) {
      container.innerHTML = '<p class="cmp-empty">No data found for the selected items. Please go back and re-select.</p>';
      return;
    }

    // Collect all canonical spec IDs across selected items, sorted by priority
    var allPropIds = [];
    var seenIds = {};
    items.forEach(function(item) {
      if (item.properties) {
        Object.keys(item.properties).forEach(function(id) {
          if (!seenIds[id]) {
            seenIds[id] = true;
            allPropIds.push(id);
          }
        });
      }
    });

    // Sort by priority (from specMeta, use original order as fallback)
    var priorityMap = {};
    var priorityIdx = 0;
    for (var key in meta) {
      priorityMap[key] = priorityIdx++;
    }
    allPropIds.forEach(function(id, idx) {
      if (!(id in priorityMap)) priorityMap[id] = 9999 + idx;
    });
    allPropIds.sort(function(a, b) { return priorityMap[a] - priorityMap[b]; });

    // Helper: get display value from property object
    function getDisplayValue(prop) {
      if (!prop) return '—';
      var raw = prop.value;
      if (typeof raw === 'number') {
        var unit = prop.unit ? ' ' + prop.unit : '';
        var cond = prop.condition ? ' (' + prop.condition + ')' : '';
        return raw + unit + cond;
      }
      return String(raw);
    }

    // Helper: get numeric value for comparison
    function getNumericValue(prop) {
      if (!prop) return NaN;
      if (typeof prop.value === 'number') return prop.value;
      if (typeof prop.value === 'string') {
        var m = prop.value.match(/([-+]?[\d.]+)/);
        return m ? parseFloat(m[1]) : NaN;
      }
      return NaN;
    }

    var html = '<div class="cmp-cards">';
    items.forEach(function(item) {
      html += '<div class="cmp-card">' +
        (item.image ? '<img src="' + item.image + '" alt="' + item.name + '" class="cmp-card__image" />' : '<div class="cmp-card__placeholder">🧵</div>') +
        (item.brand ? '<div class="cmp-card__brand">' + item.brand + '</div>' : '') +
        '<h3 class="cmp-card__model">' + item.model + '</h3>' +
        (item.priceRange ? '<div class="cmp-card__price">' + item.priceRange + '</div>' : '') +
        '<div class="cmp-card__category">' + item.category + '</div>' +
        '<a href="' + item.link + '" class="cmp-card__link">→</a>' +
        '</div>';
    });
    html += '</div>';

    html += '<div class="cmp-table-wrapper"><table class="cmp-table">';
    html += '<thead><tr><th class="cmp-table__label-col"></th>';
    items.forEach(function(item) { html += '<th>' + item.model + '</th>'; });
    html += '</tr></thead><tbody>';

    allPropIds.forEach(function(propId) {
      var props = items.map(function(item) { return item.properties ? item.properties[propId] : null; });
      var values = props.map(function(p) { return getDisplayValue(p); });
      var allSame = values.length > 1 && values.every(function(v) { return v === values[0]; });

      // Numeric comparison for best-value highlighting
      var numValues = props.map(function(p) { return getNumericValue(p); });
      var hasNumbers = numValues.some(function(n) { return !isNaN(n); });
      var propMeta = meta[propId];
      var isComparable = propMeta && propMeta.comparable;
      var highlightDir = propMeta ? propMeta.highlightDirection : 'higher_is_better';

      var maxIdx = -1;
      if (hasNumbers && !allSame && isComparable) {
        var validNums = numValues.filter(function(n) { return !isNaN(n); });
        if (validNums.length > 0) {
          var bestVal = highlightDir === 'higher_is_better'
            ? Math.max.apply(null, validNums)
            : Math.min.apply(null, validNums);
          var bestIndices = numValues.reduce(function(acc, n, i) {
            if (n === bestVal) acc.push(i);
            return acc;
          }, []);
          if (bestIndices.length === 1) maxIdx = bestIndices[0];
        }
      }

      // Check if test_method differs across items
      var testMethods = props.map(function(p) { return p && p.test_method ? p.test_method : ''; });
      var hasMethodDiff = testMethods.some(function(m, i) { return m && m !== testMethods[0]; });

      var label = labels[propId] || propId;
      html += '<tr class="' + (allSame ? 'cmp-table__row--same' : 'cmp-table__row--diff') + '">';
      html += '<td class="cmp-table__label">' + label + '</td>';
      values.forEach(function(v, i) {
        var isMax = i === maxIdx;
        var cls = [
          'cmp-table__value',
          !allSame && !isMax ? 'cmp-table__value--highlight' : '',
          isMax ? 'cmp-table__value--best' : '',
        ].filter(Boolean).join(' ');

        var methodNote = '';
        if (hasMethodDiff && testMethods[i]) {
          methodNote = ' <span class="cmp-table__method" title="Test method">(' + testMethods[i] + ')</span>';
        }

        html += '<td class="' + cls + '">' + v + methodNote + '</td>';
      });
      html += '</tr>';
    });

    html += '</tbody></table></div>';
    container.innerHTML = html;
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', renderCompare);
  } else {
    renderCompare();
  }
</script>

<style is:global>
  .cmp-page .compare-content { min-height: 200px; }
  .cmp-empty {
    text-align: center;
    color: var(--ink-3);
    padding: 60px 24px;
    font-size: 15px;
    border: 1px dashed var(--line-2);
    border-radius: var(--r-m);
    background: var(--card);
  }

  .cmp-cards { display: grid; grid-template-columns: repeat(auto-fit, minmax(200px, 1fr)); gap: 18px; margin-bottom: 34px; }
  .cmp-card {
    text-align: center;
    padding: 24px 20px;
    background: var(--card);
    border: 1px solid var(--line-2);
    border-radius: var(--r-m);
    box-shadow: var(--shadow-1);
  }
  .cmp-card__image { width: 100px; height: 100px; object-fit: contain; margin: 0 auto 14px; }
  .cmp-card__placeholder { font-size: 2.6rem; margin-bottom: 14px; }
  .cmp-card__brand { font-family: var(--font-mono); font-size: 11px; color: var(--ink-3); text-transform: uppercase; letter-spacing: 0.1em; }
  .cmp-card__model { font-family: var(--font-serif); font-size: 16px; font-weight: 700; color: var(--ink); margin: 6px 0; }
  .cmp-card__price { font-family: var(--font-mono); font-size: 14px; font-weight: 700; color: var(--green); margin-bottom: 4px; }
  .cmp-card__category { font-size: 12px; color: var(--ink-3); margin-bottom: 10px; }
  .cmp-card__link { font-size: 13px; font-weight: 700; color: var(--pen); text-decoration: none; }
  .cmp-card__link:hover { color: var(--accent); }

  .cmp-table-wrapper {
    overflow-x: auto;
    border: 1px solid var(--line-2);
    border-radius: var(--r-m);
    background: var(--card);
    box-shadow: var(--shadow-1);
    -webkit-overflow-scrolling: touch;
  }
  .cmp-table { width: 100%; border-collapse: collapse; font-size: 14px; min-width: 560px; }
  .cmp-table th, .cmp-table td { padding: 11px 16px; border-bottom: 1px solid var(--line); text-align: left; }
  .cmp-table thead th {
    background: var(--paper-2);
    font-family: var(--font-mono);
    font-size: 12px;
    font-weight: 700;
    color: var(--ink);
    border-bottom: 2px solid var(--ink);
  }
  .cmp-table tbody tr:hover td { background: rgba(49, 88, 143, 0.05); }
  .cmp-table__label-col { width: 180px; min-width: 140px; }
  .cmp-table__label { color: var(--ink-3); font-weight: 600; font-size: 12.5px; white-space: normal; word-break: break-word; line-height: 1.4; }
  .cmp-table__value { color: #36312a; }
  .cmp-table__value--highlight { color: var(--accent-2); font-weight: 600; background: var(--accent-tint); }
  .cmp-table__value--best { background: var(--green-tint); color: var(--green); font-weight: 700; }
  .cmp-table__value--best::after { content: ' ★'; font-size: 0.75em; }
  .cmp-table__row--same td { background: rgba(59, 109, 17, 0.04); }
  .cmp-table__method { font-size: 0.8em; color: var(--ink-3); font-weight: 400; font-style: italic; }
  .cmp-table tbody tr:last-child td { border-bottom: none; }
</style>
