---
/**
 * 3D打印机 - 列表页和详情页 · Paper Lab 纸感实验室
 *
 * @route /[lang]/printing/printers/[...path]
 */

import Layout from '../../../../layouts/Layout.astro';
import Card from '../../../../components/Card.astro';
import Breadcrumb from '../../../../components/Breadcrumb.astro';
import CompareWidget from '../../../../components/CompareWidget.astro';
import AffiliateLink from '../../../../components/AffiliateLink.astro';
import { getCollection, getEntry } from 'astro:content';
import { useTranslations, getLocalizedPath } from '../../../../utils/i18n';
import { languages } from '../../../../i18n/config';
import type { SupportedLocale } from '../../../../i18n/config';

export async function getStaticPaths() {
  const paths: any[] = [];
  const printers = await getCollection('printers');

  for (const lang of Object.keys(languages)) {
    paths.push({ params: { lang, path: undefined } });
    printers.forEach((printer) => {
      paths.push({ params: { lang, path: printer.id } });
    });
  }
  return paths;
}

const { lang, path: id } = Astro.params;
const currentLocale: SupportedLocale = lang as SupportedLocale;
const t = useTranslations(currentLocale);
const isListPage = !id;

const allPrinters = await getCollection('printers');

// 详情页数据
let printer: any = undefined;
let relatedModels: any[] = [];

if (!isListPage) {
  printer = await getEntry('printers', id);
  if (printer) {
    relatedModels = await getCollection('models', (entry) => {
      return 'relatedPrinters' in entry.data &&
        Array.isArray(entry.data.relatedPrinters) &&
        entry.data.relatedPrinters.some((ref: any) => (ref.id || String(ref)) === id) &&
        entry.id.startsWith(`${lang}/`);
    });
  }
}

// 分类名称
const categoryNames: Record<string, string> = {
  fdm: t('printer.category.fdm'),
  resin: t('printer.category.resin'),
  sla: t('printer.category.sla'),
};

// 多语言 helpers
const getLocalizedSpecs = (specs: any) => {
  if (!specs) return {};
  if (typeof specs === 'object' && !Array.isArray(specs) && Object.keys(specs).some(k => ['zh-cn', 'zh-tw', 'en', 'ja'].includes(k))) {
    return specs[currentLocale] || specs['zh-cn'] || specs['en'] || {};
  }
  return specs;
};

const getLocalizedKeywords = (keywords: any) => {
  if (!keywords) return [];
  if (Array.isArray(keywords)) return keywords;
  if (typeof keywords === 'object') return keywords[currentLocale] || keywords['zh-cn'] || keywords['en'] || [];
  return [];
};

// 面包屑
const breadcrumbItems: any[] = [
  { label: t('nav.home'), href: getLocalizedPath('/', currentLocale) },
  { label: t('nav.printing'), href: getLocalizedPath('/printing', currentLocale) },
  { label: t('printing.printers'), href: getLocalizedPath('/printing/printers', currentLocale) },
];
if (!isListPage && printer) {
  breadcrumbItems.push({ label: printer.data.model, current: true });
}

// 结构化数据
let structuredData: any = null;
const siteUrl = Astro.site || 'https://lingflux.com';
if (!isListPage && printer) {
  const localizedSpecs = getLocalizedSpecs(printer.data.specs);
  structuredData = {
    '@context': 'https://schema.org',
    '@type': 'Product',
    name: printer.data.model,
    brand: { '@type': 'Brand', name: printer.data.brand },
    description: localizedSpecs ? Object.entries(localizedSpecs).map(([k, v]) => `${k}: ${v}`).join(', ') : '',
    image: printer.data.image ? new URL(printer.data.image, siteUrl).href : undefined,
  };
}

const pageDescription = !isListPage && printer
  ? (() => {
      const s = getLocalizedSpecs(printer.data.specs);
      return Object.entries(s).slice(0, 3).map(([k, v]) => `${k}: ${v}`).join(', ');
    })()
  : t('printer.listDescription');

// 列表页注入对比规格数据
const specsJson = isListPage
  ? JSON.stringify(Object.fromEntries(
      allPrinters.map(p => [p.id, getLocalizedSpecs(p.data.specs)])
    ))
  : '{}';

const modelIcon = '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M21 8 12 3 3 8v8l9 5 9-5V8Z"/><path d="M3 8l9 5 9-5M12 13v8"/></svg>';
---

<Layout
  title={isListPage ? `${t('printing.printers')} - ${t('printing.title')}` : printer?.data.model}
  description={pageDescription}
  lang={lang}
  currentPath={`/${lang}/printing/printers/${id || ''}`}
  image={!isListPage && printer?.data.image ? printer.data.image : undefined}
  structuredData={structuredData}
>
  <!-- ============ 列表页 ============ -->
  {isListPage && (
    <>
      <section class="page-hero">
        <div class="container">
          <Breadcrumb items={breadcrumbItems} />
          <span class="eyebrow">SPEC SHEETS · {t('printing.printers')}</span>
          <h1>{t('printing.printers')}</h1>
          <p class="lead">{t('printer.listDescription')}</p>
          <p class="hero-stats">{allPrinters.length} PRINTERS · {t('compare.selectHint')}</p>
        </div>
      </section>

      <section class="section">
        <div class="container">
          <!-- 分类筛选（全局 JS 驱动） -->
          <div class="filter-bar" data-filter>
            <button class="filter-chip active" data-value="all">{t('printer.all')} <span class="count">{allPrinters.length}</span></button>
            {Object.entries(categoryNames)
              .filter(([key]) => allPrinters.some(p => p.data.category === key))
              .map(([key, name]) => (
                <button class="filter-chip" data-value={key}>
                  {name} <span class="count">{allPrinters.filter(p => p.data.category === key).length}</span>
                </button>
              ))}
          </div>

          <div class="card-grid card-grid--4">
            {allPrinters.map(p => {
              const localizedSpecs = getLocalizedSpecs(p.data.specs);
              return (
                <div class="compare-item" data-compare-id={p.id} data-cat={p.data.category}>
                  <label class="compare-check">
                    <input type="checkbox" class="compare-checkbox" data-compare-id={p.id} />
                    {t('compare.addToCompare')}
                  </label>
                  <Card
                    type="printer"
                    title={p.data.model}
                    link={getLocalizedPath(`/printing/printers/${p.id}`, currentLocale)}
                    brand={p.data.brand}
                    specs={localizedSpecs}
                    image={p.data.image}
                    priceRange={p.data.priceRange}
                    catLabel={categoryNames[p.data.category] || p.data.category}
                    locale={currentLocale}
                  />
                  <span class="compare-item-name">{p.data.brand} {p.data.model}</span>
                </div>
              );
            })}
          </div>
          <p class="filter-empty" style="display:none;">—</p>
        </div>
      </section>

      <!-- 注入规格数据供对比组件使用 -->
      <script is:inline set:html={`window.__compareSpecsData = ${specsJson};`} />
      <CompareWidget collectionType="printers" locale={currentLocale} />
    </>
  )}

  <!-- ============ 详情页 ============ -->
  {!isListPage && printer && (
    <main class="container">
      <div class="article-layout">
        <article class="article-body">
          <Breadcrumb items={breadcrumbItems} />

          <div class="paper-page">
            <header class="article-head">
              <div class="meta-row">
                <span class="chip chip--pen">{printer.data.brand}</span>
                <span class="chip">{categoryNames[printer.data.category] || printer.data.category}</span>
                {printer.data.priceRange && <span class="chip chip--green">{printer.data.priceRange}</span>}
              </div>
              <h1>{printer.data.model}</h1>
              <div class="detail-actions">
                {printer.data.officialUrl && (
                  <AffiliateLink url={printer.data.officialUrl} label={t('printer.officialDocs')} type="official" variant="button" locale={currentLocale} />
                )}
                {printer.data.affiliateUrl && (
                  <AffiliateLink url={printer.data.affiliateUrl} label={t('printer.buyNow')} type="affiliate" variant="button" locale={currentLocale} />
                )}
                <button
                  id="detail-add-compare"
                  class="btn btn--ghost"
                  type="button"
                  data-item-id={id}
                  data-item-name={`${printer.data.brand} ${printer.data.model}`}
                  data-item-specs={JSON.stringify(getLocalizedSpecs(printer.data.specs))}
                >
                  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="3" y="3" width="7" height="18"/><rect x="14" y="3" width="7" height="18"/></svg>
                  {t('compare.addToCompare')}
                </button>
              </div>
            </header>

            {printer.data.image && (
              <div class="article-hero-img reveal">
                <span class="tape" aria-hidden="true"></span>
                <img src={printer.data.image} alt={printer.data.model} style="object-fit:contain; max-height:320px; margin:0 auto;" />
              </div>
            )}

            <!-- 规格参数 -->
            <div class="prose"><h2>{t('printer.specs')}</h2></div>
            <div class="spec-grid">
              {Object.entries(getLocalizedSpecs(printer.data.specs) || {}).map(([key, value]) => (
                <div class="spec-cell">
                  <span class="k">{key}</span>
                  <span class="v">{String(value)}</span>
                </div>
              ))}
            </div>

            <!-- 关键词 -->
            {getLocalizedKeywords(printer.data.keywords).length > 0 && (
              <>
                <div class="prose"><h2>{t('board.relatedTags')}</h2></div>
                <div class="tag-row">
                  {getLocalizedKeywords(printer.data.keywords).map((keyword: string) => (
                    <span class="chip">{keyword}</span>
                  ))}
                </div>
              </>
            )}
          </div>
        </article>

        <!-- 侧边栏 -->
        <aside class="article-aside">
          <div class="aside-sticky">
            {relatedModels.length > 0 && (
              <div class="aside-card">
                <h4>
                  <Fragment set:html={modelIcon} />
                  {t('printer.relatedModels')}
                  <span class="count-badge">{relatedModels.length}</span>
                </h4>
                <div class="link-list">
                  {relatedModels.slice(0, 5).map(model => {
                    const modelSlug = model.id.split('/').pop()?.replace('.md', '') || '';
                    return (
                      <a href={getLocalizedPath(`/printing/models/${modelSlug}`, currentLocale)}>
                        {model.data.title}
                      </a>
                    );
                  })}
                </div>
              </div>
            )}
          </div>
        </aside>
      </div>

      <CompareWidget collectionType="printers" locale={currentLocale} />
    </main>
  )}

  <!-- 未找到 -->
  {!isListPage && !printer && (
    <section class="not-found">
      <div class="container">
        <p class="nf-code">ERROR · 404</p>
        <h1>{t('printer.notFound')}</h1>
        <a href={getLocalizedPath('/printing/printers', currentLocale)} class="btn btn--primary">{t('printer.backToList')}</a>
      </div>
    </section>
  )}
</Layout>
