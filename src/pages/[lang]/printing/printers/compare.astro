---
/**
 * 打印机参数对比 - 独立页面 · Paper Lab 纸感实验室
 *
 * URL 格式: /printing/printers/compare?item1=xxx&item2=xxx&item3=xxx
 *
 * @route /[lang]/printing/printers/compare
 */

import Layout from '../../../../layouts/Layout.astro';
import Breadcrumb from '../../../../components/Breadcrumb.astro';
import { getCollection } from 'astro:content';
import { useTranslations, getLocalizedPath } from '../../../../utils/i18n';
import { languages } from '../../../../i18n/config';
import type { SupportedLocale } from '../../../../i18n/config';

export async function getStaticPaths() {
  return Object.keys(languages).map(lang => ({ params: { lang } }));
}

const { lang } = Astro.params;
const currentLocale: SupportedLocale = lang as SupportedLocale;
const t = useTranslations(currentLocale);

const allPrinters = await getCollection('printers');

const categoryNames: Record<string, string> = {
  fdm: t('printer.category.fdm'),
  resin: t('printer.category.resin'),
  sla: t('printer.category.sla'),
};

const getLocalizedSpecs = (specs: any) => {
  if (!specs) return {};
  if (typeof specs === 'object' && !Array.isArray(specs) && Object.keys(specs).some(k => ['zh-cn', 'zh-tw', 'en', 'ja'].includes(k))) {
    return specs[currentLocale] || specs['zh-cn'] || specs['en'] || {};
  }
  return specs;
};

// All printer data for client-side lookup
const allData = JSON.stringify(Object.fromEntries(
  allPrinters.map(p => [p.id, {
    name: `${p.data.brand} ${p.data.model}`,
    brand: p.data.brand,
    model: p.data.model,
    category: categoryNames[p.data.category] || p.data.category,
    priceRange: p.data.priceRange || '',
    image: p.data.image || '',
    link: getLocalizedPath(`/printing/printers/${p.id}`, currentLocale),
    specs: getLocalizedSpecs(p.data.specs),
  }])
));

const breadcrumbItems = [
  { label: t('nav.home'), href: getLocalizedPath('/', currentLocale) },
  { label: t('nav.printing'), href: getLocalizedPath('/printing', currentLocale) },
  { label: t('printing.printers'), href: getLocalizedPath('/printing/printers', currentLocale) },
  { label: t('compare.title'), current: true },
];
---

<Layout
  title={`${t('compare.title')} - ${t('printing.printers')}`}
  description={t('printer.listDescription')}
  lang={lang}
  currentPath={`/${lang}/printing/printers/compare`}
>
  <section class="page-hero">
    <div class="container">
      <Breadcrumb items={breadcrumbItems} />
      <span class="eyebrow">SIDE BY SIDE · {t('compare.title')}</span>
      <h1>{t('compare.title')} · {t('printing.printers')}</h1>
      <p class="lead">{t('printer.listDescription')}</p>
    </div>
  </section>

  <section class="section cmp-page">
    <div class="container">
      <div id="compare-content" class="compare-content">
        <p class="cmp-empty">{t('compare.selectHint')}</p>
      </div>
      <div style="margin-top: 30px;">
        <a href={getLocalizedPath('/printing/printers', currentLocale)} class="btn btn--ghost">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M19 12H5M12 19l-7-7 7-7"/></svg>
          {t('printer.backToList')}
        </a>
      </div>
    </div>
  </section>
</Layout>

<script define:vars={{ allData }}>
  function renderCompare() {
    const params = new URLSearchParams(window.location.search);
    const ids = [];
    for (const [key, value] of params) {
      if (key.startsWith('item') && value) ids.push(decodeURIComponent(value));
    }

    const container = document.getElementById('compare-content');
    if (!container || ids.length < 2) return;

    const data = typeof allData === 'string' ? JSON.parse(allData) : allData;
    const items = ids.map(id => data[id]).filter(Boolean);
    if (items.length < 2) {
      container.innerHTML = '<p class="cmp-empty">No data found for the selected items. Please go back and re-select.</p>';
      return;
    }

    // Collect all spec keys
    const allKeys = new Set();
    items.forEach(item => { if (item.specs) Object.keys(item.specs).forEach(k => allKeys.add(k)); });

    let html = '<div class="cmp-cards">';
    items.forEach(item => {
      html += `
        <div class="cmp-card">
          ${item.image ? `<img src="${item.image}" alt="${item.name}" class="cmp-card__image" />` : '<div class="cmp-card__placeholder">🖨️</div>'}
          <div class="cmp-card__brand">${item.brand}</div>
          <h3 class="cmp-card__model">${item.model}</h3>
          ${item.priceRange ? `<div class="cmp-card__price">${item.priceRange}</div>` : ''}
          <div class="cmp-card__category">${item.category}</div>
          <a href="${item.link}" class="cmp-card__link">→</a>
        </div>`;
    });
    html += '</div>';

    // Spec comparison table
    html += '<div class="cmp-table-wrapper"><table class="cmp-table">';
    html += '<thead><tr><th class="cmp-table__label-col"></th>';
    items.forEach(item => { html += `<th>${item.model}</th>`; });
    html += '</tr></thead><tbody>';

    allKeys.forEach(key => {
      const values = items.map(item => item.specs?.[key] || '—');
      const allSame = values.length > 1 && values.every(v => v === values[0]);
      html += `<tr class="${allSame ? 'cmp-table__row--same' : 'cmp-table__row--diff'}">`;
      html += `<td class="cmp-table__label">${key}</td>`;
      values.forEach(v => {
        html += `<td class="cmp-table__value ${allSame ? '' : 'cmp-table__value--highlight'}">${v}</td>`;
      });
      html += '</tr>';
    });

    html += '</tbody></table></div>';
    container.innerHTML = html;
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', renderCompare);
  } else {
    renderCompare();
  }
</script>

<style is:global>
  .cmp-page .compare-content { min-height: 200px; }
  .cmp-empty {
    text-align: center;
    color: var(--ink-3);
    padding: 60px 24px;
    font-size: 15px;
    border: 1px dashed var(--line-2);
    border-radius: var(--r-m);
    background: var(--card);
  }

  .cmp-cards { display: grid; grid-template-columns: repeat(auto-fit, minmax(200px, 1fr)); gap: 18px; margin-bottom: 34px; }
  .cmp-card {
    text-align: center;
    padding: 24px 20px;
    background: var(--card);
    border: 1px solid var(--line-2);
    border-radius: var(--r-m);
    box-shadow: var(--shadow-1);
  }
  .cmp-card__image { width: 110px; height: 110px; object-fit: contain; margin: 0 auto 14px; }
  .cmp-card__placeholder { font-size: 3rem; margin-bottom: 14px; }
  .cmp-card__brand { font-family: var(--font-mono); font-size: 11px; color: var(--ink-3); text-transform: uppercase; letter-spacing: 0.1em; }
  .cmp-card__model { font-family: var(--font-serif); font-size: 17px; font-weight: 700; color: var(--ink); margin: 6px 0; }
  .cmp-card__price { font-family: var(--font-mono); font-size: 15px; font-weight: 700; color: var(--green); margin-bottom: 4px; }
  .cmp-card__category { font-size: 12px; color: var(--ink-3); margin-bottom: 10px; }
  .cmp-card__link { font-size: 13px; font-weight: 700; color: var(--pen); text-decoration: none; }
  .cmp-card__link:hover { color: var(--accent); }

  .cmp-table-wrapper {
    overflow-x: auto;
    border: 1px solid var(--line-2);
    border-radius: var(--r-m);
    background: var(--card);
    box-shadow: var(--shadow-1);
    -webkit-overflow-scrolling: touch;
  }
  .cmp-table { width: 100%; border-collapse: collapse; font-size: 14px; min-width: 560px; }
  .cmp-table th, .cmp-table td { padding: 11px 16px; border-bottom: 1px solid var(--line); text-align: left; }
  .cmp-table thead th {
    background: var(--paper-2);
    font-family: var(--font-mono);
    font-size: 12px;
    font-weight: 700;
    color: var(--ink);
    border-bottom: 2px solid var(--ink);
  }
  .cmp-table__label-col { width: 170px; min-width: 130px; }
  .cmp-table__label { color: var(--ink-3); font-weight: 600; font-size: 12.5px; white-space: normal; line-height: 1.4; }
  .cmp-table__value { color: #36312a; }
  .cmp-table__value--highlight { color: var(--accent-2); font-weight: 600; background: var(--accent-tint); }
  .cmp-table__row--same td { background: rgba(59, 109, 17, 0.04); }
  .cmp-table tbody tr:last-child td { border-bottom: none; }
</style>
