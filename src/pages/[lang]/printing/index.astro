---
/**
 * 3D打印 - 中心页面 · Paper Lab 纸感实验室
 *
 * @route /[lang]/printing/
 */

import Layout from '../../../layouts/Layout.astro';
import Breadcrumb from '../../../components/Breadcrumb.astro';
import { getCollection } from 'astro:content';
import { useTranslations, getLocalizedPath } from '../../../utils/i18n';
import { languages } from '../../../i18n/config';
import type { SupportedLocale } from '../../../i18n/config';

export async function getStaticPaths() {
  return Object.keys(languages).map(lang => ({ params: { lang } }));
}

const { lang } = Astro.params;
const currentLocale: SupportedLocale = lang as SupportedLocale;
const t = useTranslations(currentLocale);

// 各子栏目数量
const printers = await getCollection('printers');
const filaments = await getCollection('filaments');
const models = await getCollection('models', ({ id }) => id.startsWith(`${lang}/`));

const breadcrumbItems = [
  { label: t('nav.home'), href: getLocalizedPath('/', currentLocale) },
  { label: t('nav.printing'), current: true },
];

const subSections = [
  {
    key: 'printers',
    title: t('printing.printers'),
    description: t('printer.listDescription'),
    count: printers.length,
    link: getLocalizedPath('/printing/printers', currentLocale),
    exploreText: t('printing.explorePrinters'),
    icon: '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M6 9V2h12v7M6 18H4a2 2 0 0 1-2-2v-5a2 2 0 0 1 2-2h16a2 2 0 0 1 2 2v5a2 2 0 0 1-2 2h-2"/><rect x="6" y="14" width="12" height="8" rx="1"/></svg>',
  },
  {
    key: 'filaments',
    title: t('printing.filaments'),
    description: t('filament.listDescription'),
    count: filaments.length,
    link: getLocalizedPath('/printing/filaments', currentLocale),
    exploreText: t('printing.exploreFilaments'),
    icon: '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="9"/><circle cx="12" cy="12" r="3"/><path d="M12 3v3M12 18v3M3 12h3M18 12h3"/></svg>',
  },
  {
    key: 'models',
    title: t('printing.models'),
    description: t('model.listDescription'),
    count: models.length,
    link: getLocalizedPath('/printing/models', currentLocale),
    exploreText: t('printing.exploreModels'),
    icon: '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M21 8 12 3 3 8v8l9 5 9-5V8Z"/><path d="M3 8l9 5 9-5M12 13v8"/></svg>',
  },
];

const arrowSvg = '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14M13 6l6 6-6 6"/></svg>';
---

<Layout
  title={t('printing.title')}
  description={t('printing.description')}
  lang={lang}
  currentPath={`/${lang}/printing`}
>
  <section class="page-hero">
    <div class="container">
      <Breadcrumb items={breadcrumbItems} />
      <span class="eyebrow">WORKSHOP · {t('nav.printing')}</span>
      <h1>{t('printing.title')}</h1>
      <p class="lead">{t('printing.description')}</p>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <div class="hub-grid">
        {subSections.map((section, i) => (
          <a href={section.link} class="hub-card reveal" style={`--d:${(i * 0.07).toFixed(2)}s`}>
            <span class="hub-icon"><Fragment set:html={section.icon} /></span>
            <h3>{section.title}</h3>
            <p>{section.description}</p>
            <div class="hub-foot">
              <span class="hub-count">× {section.count}</span>
              <span class="card-link">
                {section.exploreText}
                <Fragment set:html={arrowSvg} />
              </span>
            </div>
          </a>
        ))}
      </div>
    </div>
  </section>
</Layout>
