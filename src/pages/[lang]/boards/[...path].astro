---
/**
 * 开发板 - 列表页和详情页 · Paper Lab 纸感实验室
 *
 * @route /[lang]/boards/[...path]
 */

import Layout from '../../../layouts/Layout.astro';
import Card from '../../../components/Card.astro';
import Breadcrumb from '../../../components/Breadcrumb.astro';
import AffiliateLink from '../../../components/AffiliateLink.astro';
import { getCollection, getEntry } from 'astro:content';
import { useTranslations, getLocalizedPath } from '../../../utils/i18n';
import { languages } from '../../../i18n/config';
import type { SupportedLocale } from '../../../i18n/config';
import type { CollectionEntry } from 'astro:content';

export async function getStaticPaths() {
  const paths: any[] = [];

  const boards = await getCollection('boards');

  for (const lang of Object.keys(languages)) {
    paths.push({ params: { lang, path: undefined } });

    boards.forEach((board) => {
      paths.push({ params: { lang, path: board.id } });
    });
  }

  return paths;
}

const { lang, path: id } = Astro.params;
const currentLocale: SupportedLocale = lang as SupportedLocale;
const t = useTranslations(currentLocale);

const isListPage = !id;

const allBoards = await getCollection('boards');

// 详情页数据
let board: CollectionEntry<'boards'> | undefined = undefined;
let relatedExperiments: CollectionEntry<'experiments'>[] = [];
let relatedSolutions: CollectionEntry<'solutions'>[] = [];
let currentDoc: any = null;

if (!isListPage) {
  board = await getEntry('boards', id);
  if (board) {
    relatedExperiments = await getCollection('experiments', (entry) => {
      const boardId = entry.data.boardId;
      const boardIdStr = typeof boardId === 'object' && boardId !== null ? boardId.id : String(boardId);
      return boardIdStr === id && entry.id.includes(`/${lang}/`);
    });

    relatedSolutions = await getCollection('solutions', (entry) => {
      const boardId = entry.data.boardId;
      const boardIdStr = typeof boardId === 'object' && boardId !== null ? boardId.id : String(boardId);
      return boardIdStr === id && entry.id.includes(`/${lang}/`);
    });

    const allBoardDocs = await getCollection('boardDocs', (entry) => {
      return 'boardId' in entry.data && entry.data.boardId;
    });

    currentDoc = allBoardDocs.find((doc: any) => {
      const docBoardId = (doc.data.boardId as any).id || String(doc.data.boardId);
      return docBoardId === id && doc.id.startsWith(`${lang}/`);
    });
  }
}

// 面包屑
const breadcrumbItems = [
  { label: t('nav.home'), href: getLocalizedPath('/', currentLocale) },
  { label: t('nav.boards'), href: getLocalizedPath('/boards', currentLocale) },
];

if (!isListPage && board) {
  breadcrumbItems.push({ label: board.data.model, current: true } as any);
}

// 多语言 specs / keywords
const getLocalizedSpecs = (specs: any) => {
  if (!specs) return {};
  if (typeof specs === 'object' && !Array.isArray(specs) && Object.keys(specs).some(k => ['zh-cn', 'zh-tw', 'en', 'ja'].includes(k))) {
    return specs[currentLocale] || specs['zh-cn'] || {};
  }
  return specs;
};

const getLocalizedKeywords = (keywords: any) => {
  if (!keywords) return [];
  if (Array.isArray(keywords)) return keywords;
  if (typeof keywords === 'object' && !Array.isArray(keywords)) {
    return keywords[currentLocale] || keywords['zh-cn'] || [];
  }
  return [];
};

// 结构化数据
let structuredData: any = null;
const siteUrl = Astro.site || 'https://lingflux.com';

if (!isListPage && board) {
  const localizedSpecs = getLocalizedSpecs(board.data.specs);
  const boardSpecs = localizedSpecs ? Object.entries(localizedSpecs).map(([k, v]) => `${k}: ${v}`).join(', ') : '';
  structuredData = {
    '@context': 'https://schema.org',
    '@type': 'Product',
    name: board.data.model,
    brand: { '@type': 'Brand', name: board.data.brand },
    description: boardSpecs || `${board.data.brand} ${board.data.model} 开发板`,
    image: board.data.image ? new URL(board.data.image, siteUrl).href : undefined
  };
}

const pageDescription = !isListPage && board
  ? (() => {
      const localizedSpecs = getLocalizedSpecs(board.data.specs);
      return localizedSpecs ? Object.entries(localizedSpecs).slice(0, 3).map(([k, v]) => `${k}: ${v}`).join(', ') : `${board.data.brand} ${board.data.model} 开发板的详细规格参数与使用说明`;
    })()
  : t('board.listDescription');

const docIcon = '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8Z"/><path d="M14 2v6h6M8 13h8M8 17h5"/></svg>';
const boardIcon = '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"><rect x="6" y="6" width="12" height="12" rx="2"/><path d="M9 6V3M15 6V3M9 21v-3M15 21v-3M6 9H3M6 15H3M21 9h-3M21 15h-3"/></svg>';
const boltIcon = '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M13 2 4.5 13.5H11L9.5 22 19 9.5h-6.5L13 2Z"/></svg>';
---

<Layout
  title={isListPage ? t('nav.boards') : board?.data.model}
  description={pageDescription}
  lang={lang}
  currentPath={`/${lang}/boards/${id || ''}`}
  image={!isListPage && board?.data.image ? board.data.image : undefined}
  structuredData={structuredData}
>
  <!-- ============ 列表页 ============ -->
  {isListPage && (
    <>
      <section class="page-hero">
        <div class="container">
          <Breadcrumb items={breadcrumbItems} />
          <span class="eyebrow">DATASHEETS · {t('nav.boards')}</span>
          <h1>{t('nav.boards')}</h1>
          <p class="lead">{t('board.listDescription')}</p>
          <p class="hero-stats">{allBoards.length} BOARDS</p>
        </div>
      </section>

      <section class="section">
        <div class="container">
          <!-- 品牌筛选（全局 JS 驱动） -->
          <div class="filter-bar" data-filter>
            <button class="filter-chip active" data-value="all">{t('board.all')} <span class="count">{allBoards.length}</span></button>
            {Array.from(new Set(allBoards.map(b => b.data.brand))).map(brand => (
              <button class="filter-chip" data-value={brand}>{brand}</button>
            ))}
          </div>

          <div class="card-grid card-grid--4">
            {allBoards.map(board => {
              const localizedSpecs = getLocalizedSpecs(board.data.specs);
              return (
                <Card
                  type="board"
                  title={board.data.model}
                  link={getLocalizedPath(`/boards/${board.id}`, currentLocale)}
                  brand={board.data.brand}
                  specs={localizedSpecs}
                  image={board.data.image}
                  catLabel={board.data.brand}
                  locale={currentLocale}
                  data-cat={board.data.brand}
                />
              );
            })}
          </div>
          <p class="filter-empty" style="display:none;">—</p>
        </div>
      </section>
    </>
  )}

  <!-- ============ 详情页 ============ -->
  {!isListPage && board && (
    <main class="container">
      <div class="article-layout">
        <article class="article-body">
          <Breadcrumb items={breadcrumbItems} />

          <div class="paper-page">
            <header class="article-head">
              <div class="meta-row">
                <span class="chip chip--pen">{board.data.brand}</span>
                <span class="chip">{t('nav.boards')}</span>
              </div>
              <h1>{board.data.model}</h1>
              <div class="detail-actions">
                {board.data.officialUrl && (
                  <AffiliateLink url={board.data.officialUrl} label={t('board.officialDocs')} type="official" variant="button" locale={currentLocale} />
                )}
              </div>
            </header>

            {board.data.image && (
              <div class="article-hero-img reveal">
                <span class="tape" aria-hidden="true"></span>
                <img src={board.data.image} alt={board.data.model} style="object-fit:contain; max-height:320px; margin:0 auto;" />
              </div>
            )}

            <!-- 规格参数：数据手册风 -->
            <div class="prose">
              <h2>{t('board.specs')}</h2>
            </div>
            <div class="spec-grid">
              {Object.entries(getLocalizedSpecs(board.data.specs) || {}).map(([key, value]) => (
                <div class="spec-cell">
                  <span class="k">{key}</span>
                  <span class="v">{String(value)}</span>
                </div>
              ))}
            </div>

            <!-- 关键词 -->
            {getLocalizedKeywords(board.data.keywords).length > 0 && (
              <>
                <div class="prose"><h2>{t('board.relatedTags')}</h2></div>
                <div class="tag-row">
                  {getLocalizedKeywords(board.data.keywords).map((keyword: string) => (
                    <span class="chip">{keyword}</span>
                  ))}
                </div>
              </>
            )}

            <!-- 开发板详细文档 -->
            {currentDoc && (
              <div class="prose" set:html={currentDoc.rendered?.html} />
            )}
          </div>
        </article>

        <!-- 侧边栏 -->
        <aside class="article-aside">
          <div class="aside-sticky">
            {relatedExperiments.length > 0 && (
              <div class="aside-card">
                <h4>
                  <Fragment set:html={boltIcon} />
                  {t('board.relatedExperiments')}
                  <span class="count-badge">{relatedExperiments.length}</span>
                </h4>
                <div class="link-list">
                  {relatedExperiments.slice(0, 5).map(exp => {
                    const pathParts = exp.id.split('/');
                    const category = pathParts[0];
                    const expSlug = pathParts[pathParts.length - 1].replace(/\.md$/, '');
                    return (
                      <a href={getLocalizedPath(`/experiments/${category}/${expSlug}`, currentLocale)}>
                        {exp.data.title}
                      </a>
                    );
                  })}
                </div>
              </div>
            )}

            {relatedSolutions.length > 0 && (
              <div class="aside-card">
                <h4>
                  <Fragment set:html={docIcon} />
                  {t('board.relatedSolutions')}
                  <span class="count-badge">{relatedSolutions.length}</span>
                </h4>
                <div class="link-list">
                  {relatedSolutions.slice(0, 5).map(sol => (
                    <a href={getLocalizedPath(`/solutions/${sol.id.replace(/^[a-z-]+\//, '').replace('.md', '')}`, currentLocale)}>
                      {sol.data.title}
                    </a>
                  ))}
                </div>
              </div>
            )}
          </div>
        </aside>
      </div>
    </main>
  )}

  <!-- 未找到 -->
  {!isListPage && !board && (
    <section class="not-found">
      <div class="container">
        <p class="nf-code">ERROR · 404</p>
        <h1>{t('board.notFound')}</h1>
        <a href={getLocalizedPath('/boards', currentLocale)} class="btn btn--primary">{t('board.backToList')}</a>
      </div>
    </section>
  )}
</Layout>
