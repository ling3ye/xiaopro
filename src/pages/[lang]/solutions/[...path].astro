---
/**
 * 实战方案 - 列表页和详情页 · Paper Lab 纸感实验室
 *
 * @route /[lang]/solutions/[...path]
 */

import Layout from '../../../layouts/Layout.astro';
import Card from '../../../components/Card.astro';
import Breadcrumb from '../../../components/Breadcrumb.astro';
import Pagination from '../../../components/Pagination.astro';
import { getCollection, getEntry } from 'astro:content';
import { useTranslations, getLocalizedPath } from '../../../utils/i18n';
import { languages } from '../../../i18n/config';
import type { SupportedLocale } from '../../../i18n/config';

export async function getStaticPaths() {
  const paths: any[] = [];
  const ITEMS_PER_PAGE = 12;

  const allSolutions = await getCollection('solutions');

  for (const lang of Object.keys(languages)) {
    const solutions = allSolutions.filter(({ id }) => id.startsWith(`${lang}/`));

    const totalItems = solutions.length;
    const totalPages = Math.ceil(totalItems / ITEMS_PER_PAGE) || 1;

    for (let page = 1; page <= totalPages; page++) {
      const pagePath = page === 1 ? undefined : `page/${page}`;
      paths.push({ params: { lang, path: pagePath } });
    }

    solutions.forEach((solution) => {
      const pathParts = solution.id.split('/');
      const slug = pathParts[pathParts.length - 1].replace(/\.md$/, '');
      paths.push({ params: { lang, path: slug } });
    });
  }

  return paths;
}

const { lang, path: slug } = Astro.params;
const currentLocale: SupportedLocale = lang as SupportedLocale;
const t = useTranslations(currentLocale);

const isListPage = !slug || (slug && slug.startsWith('page/'));

const ITEMS_PER_PAGE = 12;
let currentPage = 1;

if (slug && slug.startsWith('page/')) {
  const pageNum = slug.replace('page/', '');
  currentPage = Number(pageNum) || 1;
}

const allSolutions = await getCollection('solutions', ({ id }) => {
  return id.startsWith(`${lang}/`);
});

const totalItems = allSolutions.length;
const totalPages = Math.ceil(totalItems / ITEMS_PER_PAGE) || 1;
const startIndex = (currentPage - 1) * ITEMS_PER_PAGE;
const endIndex = startIndex + ITEMS_PER_PAGE;
const currentSolutions = allSolutions.slice(startIndex, endIndex);

// 详情页数据
let solution: any = null;
let board = null;
let modules: any[] = [];

if (!isListPage) {
  const entry = await getEntry('solutions', `${lang}/${slug}`);
  if (entry) {
    solution = entry;
    if ('boardId' in solution.data && solution.data.boardId) {
      const boardId = (solution.data.boardId as any).id || String(solution.data.boardId);
      board = await getEntry('boards', boardId);
    }
    if ('moduleIds' in solution.data && Array.isArray(solution.data.moduleIds)) {
      modules = await Promise.all(
        solution.data.moduleIds.map(async (moduleId: any) => {
          const id = moduleId.id || String(moduleId);
          return getEntry('modules', id);
        })
      );
      modules = modules.filter(Boolean);
    }
  } else {
    console.warn('Entry not found for ID:', `${lang}/${slug}`);
  }
}

// 上一篇 / 下一篇
let prevSol: any = null;
let nextSol: any = null;
const solLink = (s: any) =>
  getLocalizedPath(`/solutions/${s.id.replace(`${lang}/`, '').replace('.md', '')}`, currentLocale);
if (!isListPage && solution) {
  const idx = allSolutions.findIndex(s => s.id === solution.id);
  if (idx > 0) prevSol = allSolutions[idx - 1];
  if (idx >= 0 && idx < allSolutions.length - 1) nextSol = allSolutions[idx + 1];
}

// 面包屑
const breadcrumbItems = [
  { label: t('nav.home'), href: getLocalizedPath('/', currentLocale) },
  { label: t('nav.solutions'), href: getLocalizedPath('/solutions', currentLocale) },
];

if (!isListPage && solution) {
  breadcrumbItems.push({ label: solution.data.title, current: true } as any);
}

// 结构化数据
let structuredData: any = null;
const siteUrl = Astro.site || 'https://lingflux.com';

if (!isListPage && solution) {
  structuredData = {
    '@context': 'https://schema.org',
    '@type': 'TechArticle',
    headline: solution.data.title,
    description: solution.data.intro || '',
    image: solution.data.image ? new URL(solution.data.image, siteUrl).href : undefined,
    datePublished: solution.data.date ? (solution.data.date as Date).toISOString() : undefined,
    author: { '@type': 'Organization', name: 'LINGFLUX' },
    publisher: {
      '@type': 'Organization',
      name: 'LINGFLUX',
      logo: { '@type': 'ImageObject', url: new URL('/logo.png', siteUrl).href }
    }
  };
}

const pageDescription = !isListPage && solution
  ? solution.data.intro || t('home.hero.description')
  : t('solutions.listDescription');

const robotsMeta = currentPage > 1 ? 'noindex, follow' : undefined;

// 难度 chip 样式
const difficultyChip: Record<string, string> = {
  Easy: 'chip--green',
  Medium: 'chip--accent',
  Hard: 'chip--ink',
};

const tocIcon = '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><path d="M8 6h13M8 12h13M8 18h13M3.5 6h.01M3.5 12h.01M3.5 18h.01"/></svg>';
const boardIcon = '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"><rect x="6" y="6" width="12" height="12" rx="2"/><path d="M9 6V3M15 6V3M9 21v-3M15 21v-3M6 9H3M6 15H3M21 9h-3M21 15h-3"/></svg>';
const moduleIcon = '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M12 2 2 7l10 5 10-5-10-5Z"/><path d="m2 17 10 5 10-5M2 12l10 5 10-5"/></svg>';
const boltIcon = '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M13 2 4.5 13.5H11L9.5 22 19 9.5h-6.5L13 2Z"/></svg>';
---

<Layout
  title={isListPage ? t('nav.solutions') : solution?.data.title}
  description={pageDescription}
  lang={lang}
  currentPath={`/${lang}/solutions/${slug || ''}`}
  image={!isListPage && solution?.data.image ? solution.data.image : undefined}
  robots={robotsMeta}
  structuredData={structuredData}
>
  <!-- ============ 列表页 ============ -->
  {isListPage && (
    <>
      <section class="page-hero">
        <div class="container">
          <Breadcrumb items={breadcrumbItems} />
          <span class="eyebrow">FIELD REPORTS · {t('nav.solutions')}</span>
          <h1>{t('nav.solutions')}</h1>
          <p class="lead">{t('solutions.listDescription')}</p>
          <p class="hero-stats">
            {startIndex + 1}–{Math.min(endIndex, totalItems)} / {t('solutions.totalItems').replace('{count}', String(totalItems))}
          </p>
        </div>
      </section>

      <section class="section">
        <div class="container">
          <div class="card-grid">
            {currentSolutions.map(sol => (
              <Card
                type="article"
                title={sol.data.title}
                description={sol.data.intro}
                link={getLocalizedPath(`/solutions/${sol.id.replace(`${lang}/`, '').replace('.md', '')}`, currentLocale)}
                tags={[t('solutions.caseTag')]}
                difficulty={('difficulty' in sol.data ? sol.data.difficulty as 'Easy' | 'Medium' | 'Hard' : undefined)}
                image={sol.data.image}
                locale={currentLocale}
              />
            ))}
          </div>

          <Pagination
            currentPage={currentPage}
            totalPages={totalPages}
            baseUrl={getLocalizedPath('/solutions', currentLocale)}
            getUrl={(page) => getLocalizedPath(page === 1 ? '/solutions' : `/solutions/page/${page}`, currentLocale)}
          />
        </div>
      </section>
    </>
  )}

  <!-- ============ 详情页 ============ -->
  {!isListPage && solution && (
    <main class="container">
      <div class="article-layout">
        <article class="article-body">
          <Breadcrumb items={breadcrumbItems} />

          <div class="paper-page">
            <header class="article-head">
              <div class="meta-row">
                <span class="chip chip--accent">{t('solutions.caseTag')}</span>
                {('difficulty' in solution.data) && (
                  <span class={`chip ${difficultyChip[solution.data.difficulty as string] || ''}`}>
                    {solution.data.difficulty}
                  </span>
                )}
                {board && (
                  <a class="chip" href={getLocalizedPath(`/boards/${board.id}`, currentLocale)}>
                    <Fragment set:html={boardIcon} />
                    {board.data.brand} {board.data.model}
                  </a>
                )}
                {modules.map((mod: any) => (
                  <a class="chip" href={getLocalizedPath(`/modules/${mod.id}`, currentLocale)}>
                    <Fragment set:html={moduleIcon} />
                    {mod.data.model}
                  </a>
                ))}
              </div>
              <h1>{solution.data.title}</h1>
              {solution.data.intro && <p class="intro">{solution.data.intro}</p>}
            </header>

            {solution.data.image && (
              <div class="article-hero-img reveal">
                <span class="tape" aria-hidden="true"></span>
                <img src={solution.data.image} alt={solution.data.title} />
              </div>
            )}

            <!-- 移动端目录（JS 自动填充） -->
            <nav class="toc-mobile">
              <details>
                <summary>
                  <Fragment set:html={tocIcon} />
                  INDEX · {t('ui.toc')}
                  <svg class="chev" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="m6 9 6 6 6-6"/></svg>
                </summary>
                <div class="toc" data-toc></div>
              </details>
            </nav>

            <div class="prose" set:html={solution.rendered?.html} />

            <!-- 上一篇 / 下一篇 -->
            <nav class="pager-nav" aria-label="More solutions">
              {prevSol ? (
                <a href={solLink(prevSol)} class="prev">
                  <span class="dir">← PREV</span>
                  <span class="t">{prevSol.data.title}</span>
                </a>
              ) : <span></span>}
              {nextSol ? (
                <a href={solLink(nextSol)} class="next">
                  <span class="dir">NEXT →</span>
                  <span class="t">{nextSol.data.title}</span>
                </a>
              ) : <span></span>}
            </nav>
          </div>
        </article>

        <!-- 侧边栏 -->
        <aside class="article-aside">
          <div class="aside-sticky">
            <div class="aside-card">
              <h4><Fragment set:html={tocIcon} />INDEX · {t('ui.toc')}</h4>
              <nav class="toc" data-toc aria-label={t('ui.toc')}></nav>
            </div>

            {(board || modules.length > 0) && (
              <div class="aside-card">
                <h4><Fragment set:html={boardIcon} />PARTS · {t('ui.related')}</h4>
                {board && (
                  <a class="hw-card" href={getLocalizedPath(`/boards/${board.id}`, currentLocale)}>
                    <span class="module-icon"><Fragment set:html={boardIcon} /></span>
                    <span>
                      <span class="n">{board.data.model}</span><br />
                      <span class="r">{t('solutions.usedBoard')} · {board.data.brand}</span>
                    </span>
                  </a>
                )}
                {modules.map((mod: any) => (
                  <a class="hw-card" href={getLocalizedPath(`/modules/${mod.id}`, currentLocale)}>
                    <span class="module-icon"><Fragment set:html={moduleIcon} /></span>
                    <span>
                      <span class="n">{mod.data.model}</span><br />
                      <span class="r">{t('nav.modules')}{mod.data.brand ? ` · ${mod.data.brand}` : ''}</span>
                    </span>
                  </a>
                ))}
              </div>
            )}

            <div class="aside-card">
              <h4><Fragment set:html={boltIcon} />RELATED · {t('solutions.related')}</h4>
              <div class="link-list">
                {allSolutions
                  .filter(s => s.id !== `${lang}/${slug}.md`)
                  .slice(0, 5)
                  .map(related => (
                    <a href={solLink(related)}>{related.data.title}</a>
                  ))}
              </div>
            </div>
          </div>
        </aside>
      </div>
    </main>
  )}

  <!-- 未找到 -->
  {!isListPage && !solution && (
    <section class="not-found">
      <div class="container">
        <p class="nf-code">ERROR · 404</p>
        <h1>{t('solutions.notFound')}</h1>
        <a href={getLocalizedPath('/solutions', currentLocale)} class="btn btn--primary">{t('solutions.backToList')}</a>
      </div>
    </section>
  )}
</Layout>
