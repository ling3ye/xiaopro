---
/**
 * 首页 · Paper Lab 纸感实验室
 *
 * Hero（实验记录卡）+ 统计台账 + 精选 + 最新 + 常用模块 + 最新文章 + CTA
 *
 * @route /[lang]/
 */

import Layout from '../../layouts/Layout.astro';
import Card from '../../components/Card.astro';
import { getCollection, getEntry } from 'astro:content';
import { useTranslations, getLocalizedPath } from '../../utils/i18n';
import { languages } from '../../i18n/config';
import type { SupportedLocale } from '../../i18n/config';

export function getStaticPaths() {
  return Object.keys(languages).map((lang) => {
    return { params: { lang } };
  });
}

const { lang } = Astro.params;
const t = useTranslations(lang as SupportedLocale);
const currentLocale: SupportedLocale = lang as SupportedLocale;

// 实验与方案
const experiments = await getCollection('experiments', ({ id }) => {
  return id.includes(`/${lang}/`);
});
const solutions = await getCollection('solutions', ({ id }) => {
  return id.startsWith(`${lang}/`);
});

// 开发板 / 模块 / 文章
const boards = await getCollection('boards');
const modules = await getCollection('modules');
const articles = await getCollection('articles', ({ id }) => {
  return id.startsWith(`${lang}/`);
});

// 辅助函数：安全获取文章日期
function getArticleDate(article: any): number {
  return 'date' in article.data && article.data.date instanceof Date
    ? article.data.date.getTime()
    : 0;
}

// 按日期排序，限制 10 条
const allArticles = [...experiments, ...solutions]
  .sort((a, b) => getArticleDate(b) - getArticleDate(a))
  .slice(0, 10);

// 特色文章（最新 1 篇做大卡）
const featuredArticle = allArticles[0];
// 其余最新
const recentArticles = allArticles.slice(1, 9);

// 构建实验/方案链接
function buildArticleLink(article: any): string {
  if (article.collection === 'experiments') {
    const category = article.id.split('/')[0];
    const slug = article.id.replace('.md', '').split('/').pop();
    return getLocalizedPath(`/${article.collection}/${category}/${slug}`, currentLocale);
  }
  const slug = article.id.replace('.md', '').split('/').pop();
  return getLocalizedPath(`/${article.collection}/${slug}`, currentLocale);
}

// Hero 记录卡数据：取最新一篇实验/方案
let heroBoard: any = null;
let heroModule: any = null;
if (featuredArticle) {
  const bd = (featuredArticle.data as any).boardId;
  if (bd) heroBoard = await getEntry('boards', bd.id || bd).catch(() => null);
  const md = (featuredArticle.data as any).moduleId || (featuredArticle.data as any).moduleIds?.[0];
  if (md) heroModule = await getEntry('modules', md.id || md).catch(() => null);
}

// 最新文章（按日期）
const latestArticles = articles
  .sort((a, b) => getArticleDate(b) - getArticleDate(a))
  .slice(0, 4);

// 统计数据
const totalPages =
  experiments.length + solutions.length + articles.length +
  boards.length + modules.length;

const siteUrl = Astro.site || 'https://lingflux.com';
const structuredData = {
  '@context': 'https://schema.org',
  '@type': 'WebSite',
  name: 'LINGFLUX',
  description: t('home.hero.description'),
  url: new URL(`/${lang}/`, siteUrl).href,
  inLanguage: lang,
};

const arrowSvg = '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14M13 6l6 6-6 6"/></svg>';
---

<Layout
  title={t('nav.home')}
  lang={lang}
  currentPath={`/${lang}/`}
  structuredData={structuredData}
>
  <!-- ================= Hero：实验记录卡 ================= -->
  <section class="hero">
    <div class="container">
      <div>
        <span class="eyebrow">LAB NOTES · OPEN HARDWARE</span>
        <h1>{t('home.hero.title')}</h1>
        <p class="hero-lead">{t('home.hero.description')}</p>
        <div class="hero-cta">
          <a class="btn btn--primary" href={getLocalizedPath('/experiments', currentLocale)}>
            {t('home.hero.startLearning')}
            <Fragment set:html={arrowSvg} />
          </a>
          <a class="btn btn--ghost" href={getLocalizedPath('/modules', currentLocale)}>
            {t('home.hero.exploreHardware')}
          </a>
          <span class="hero-note"><b>✓</b> {t('home.hero.verified')}</span>
        </div>
      </div>

      {featuredArticle && (
        <div class="hero-visual reveal">
          <div class="record-card">
            <span class="tape tape--tl" aria-hidden="true"></span>
            <span class="tape tape--tr" aria-hidden="true"></span>
            <div class="rc-head">
              <span class="rc-no">NO. LF-{(featuredArticle.data as any).date instanceof Date ? (featuredArticle.data as any).date.toISOString().slice(0, 10).replace(/-/g, '-') : '0000'}</span>
              <span>{(featuredArticle.data as any).date instanceof Date ? (featuredArticle.data as any).date.toISOString().slice(0, 10) : ''}</span>
            </div>
            <h3 class="rc-title">
              <a href={buildArticleLink(featuredArticle)}>{featuredArticle.data.title}</a>
            </h3>
            <div class="rc-sub">
              {featuredArticle.collection === 'experiments' ? t('nav.experiments') : t('nav.solutions')} · EXPERIMENT RECORD
            </div>
            <div class="rc-rows">
              {heroBoard && (
                <div class="rc-row">
                  <span>{t('experiments.usedBoard')}</span>
                  <b>{heroBoard.data.brand} {heroBoard.data.model}</b>
                </div>
              )}
              {heroModule && (
                <div class="rc-row">
                  <span>{t('experiments.usedModule')}</span>
                  <b>{heroModule.data.brand ? `${heroModule.data.brand} ` : ''}{heroModule.data.model}</b>
                </div>
              )}
              <div class="rc-row">
                <span>{t('nav.articles')}</span>
                <b class="ok">VERIFIED ✓</b>
              </div>
            </div>
            <div class="rc-foot">
              <span class="stamp">VERIFIED</span>
              <span class="rc-sign">lingflux lab</span>
            </div>
          </div>
          <div class="hero-badge-float hbf--1">{t('home.hero.verified')}</div>
          <div class="hero-badge-float hbf--2">9 {t('home.stats.languages')}<small>9 LANGUAGES</small></div>
        </div>
      )}
    </div>

    <!-- 统计台账 -->
    <div class="container">
      <div class="stats reveal">
        <div class="stat">
          <div class="stat-num"><span data-count={experiments.length}>0</span></div>
          <div class="stat-label">{t('home.stats.experiments')}</div>
        </div>
        <div class="stat">
          <div class="stat-num"><span data-count={modules.length}>0</span></div>
          <div class="stat-label">{t('home.stats.modules')}</div>
        </div>
        <div class="stat">
          <div class="stat-num"><span data-count={Object.keys(languages).length}>0</span></div>
          <div class="stat-label">{t('home.stats.languages')}</div>
        </div>
        <div class="stat">
          <div class="stat-num"><span data-count={totalPages}>0</span><span class="suffix">+</span></div>
          <div class="stat-label">{t('home.stats.pages')}</div>
        </div>
      </div>
    </div>
  </section>

  <!-- ================= 精选 ================= -->
  {featuredArticle && (
    <section class="section">
      <div class="container">
        <div class="section-head reveal">
          <span class="eyebrow">FIG. 01 · {t('home.featured')}</span>
          <h2>{t('home.featured')}</h2>
        </div>
        <Card
          type="article"
          title={featuredArticle.data.title}
          description={(featuredArticle.data as any).intro}
          link={buildArticleLink(featuredArticle)}
          tags={[featuredArticle.collection === 'experiments' ? t('nav.experiments') : t('nav.solutions')]}
          date={(featuredArticle.data as any).date instanceof Date ? (featuredArticle.data as any).date : undefined}
          featured={true}
          image={(featuredArticle.data as any).image}
          locale={currentLocale}
        />
      </div>
    </section>
  )}

  <!-- ================= 最新内容 ================= -->
  {recentArticles.length > 0 && (
    <section class="section section--alt">
      <div class="container">
        <div class="section-head section-head-row reveal">
          <div>
            <span class="eyebrow">FIG. 02 · {t('home.recent')}</span>
            <h2>{t('home.recent')}</h2>
          </div>
          <a class="btn btn--ghost btn--sm view-all" href={getLocalizedPath('/experiments', currentLocale)}>
            {t('home.viewAll')}
            <Fragment set:html={arrowSvg} />
          </a>
        </div>
        <div class="card-grid card-grid--4">
          {recentArticles.map((article, i) => (
            <Card
              type="article"
              title={article.data.title}
              description={(article.data as any).intro}
              link={buildArticleLink(article)}
              tags={[article.collection === 'experiments' ? t('nav.experiments') : t('nav.solutions')]}
              date={(article.data as any).date instanceof Date ? (article.data as any).date : undefined}
              image={(article.data as any).image}
              locale={currentLocale}
            />
          ))}
        </div>
      </div>
    </section>
  )}

  <!-- ================= 常用模块 ================= -->
  {modules.length > 0 && (
    <section class="section">
      <div class="container">
        <div class="section-head section-head-row reveal">
          <div>
            <span class="eyebrow">FIG. 03 · {t('nav.modules')}</span>
            <h2>{t('home.popularModules')}</h2>
          </div>
          <a class="btn btn--ghost btn--sm view-all" href={getLocalizedPath('/modules', currentLocale)}>
            {t('home.viewAll')}
            <Fragment set:html={arrowSvg} />
          </a>
        </div>
        <div class="card-grid card-grid--4">
          {modules.slice(0, 4).map(mod => {
            const specs = (mod.data.specs && !('zh-cn' in (mod.data.specs as any)))
              ? mod.data.specs as Record<string, string | number | boolean>
              : ((mod.data.specs as any)?.[currentLocale] || (mod.data.specs as any)?.['en'] || {});
            return (
              <Card
                type="module"
                title={mod.data.model}
                link={getLocalizedPath(`/modules/${mod.id}`, currentLocale)}
                brand={mod.data.brand}
                specs={specs}
                image={mod.data.image}
                catLabel={t(`module.category.${mod.data.category}` as any)}
                locale={currentLocale}
              />
            );
          })}
        </div>
      </div>
    </section>
  )}

  <!-- ================= 最新文章 ================= -->
  {latestArticles.length > 0 && (
    <section class="section section--alt">
      <div class="container">
        <div class="section-head section-head-row reveal">
          <div>
            <span class="eyebrow">FIG. 04 · {t('nav.articles')}</span>
            <h2>{t('home.latestArticles')}</h2>
          </div>
          <a class="btn btn--ghost btn--sm view-all" href={getLocalizedPath('/articles', currentLocale)}>
            {t('home.viewAll')}
            <Fragment set:html={arrowSvg} />
          </a>
        </div>
        <div class="card-grid card-grid--4">
          {latestArticles.map(article => {
            const slug = article.id.replace('.md', '').split('/').pop();
            return (
              <Card
                type="article"
                title={article.data.title}
                description={article.data.intro}
                link={getLocalizedPath(`/articles/${article.data.domain}/${slug}`, currentLocale)}
                tags={[t(`articles.domain.${article.data.domain}` as any)]}
                date={article.data.date}
                image={article.data.image}
                locale={currentLocale}
              />
            );
          })}
        </div>
      </div>
    </section>
  )}

  <!-- ================= 热门开发板 ================= -->
  {boards.length > 0 && (
    <section class="section">
      <div class="container">
        <div class="section-head section-head-row reveal">
          <div>
            <span class="eyebrow">FIG. 05 · {t('nav.boards')}</span>
            <h2>{t('home.popularHardware')}</h2>
          </div>
          <a class="btn btn--ghost btn--sm view-all" href={getLocalizedPath('/boards', currentLocale)}>
            {t('home.viewAll')}
            <Fragment set:html={arrowSvg} />
          </a>
        </div>
        <div class="card-grid card-grid--4">
          {boards.slice(0, 8).map(board => {
            const localizedSpecs = (board.data.specs as any)?.[currentLocale]
              || (board.data.specs as any)?.['en']
              || board.data.specs
              || {};
            return (
              <Card
                type="board"
                title={board.data.model}
                link={getLocalizedPath(`/boards/${board.id}`, currentLocale)}
                brand={board.data.brand}
                specs={localizedSpecs as Record<string, string | number | boolean>}
                image={board.data.image}
                locale={currentLocale}
              />
            );
          })}
        </div>
      </div>
    </section>
  )}

  <!-- ================= CTA ================= -->
  <section class="section">
    <div class="container">
      <div class="cta-banner reveal">
        <h2>{t('home.cta.title')}</h2>
        <p>{t('home.cta.description')}</p>
        <div class="hero-cta">
          <a class="btn btn--primary" href={getLocalizedPath('/experiments', currentLocale)}>
            {t('home.cta.button')}
            <Fragment set:html={arrowSvg} />
          </a>
          <a class="btn btn--ghost" href={getLocalizedPath('/boards', currentLocale)}>
            {t('home.hero.exploreHardware')}
          </a>
        </div>
      </div>
    </div>
  </section>
</Layout>

<style>
  /* 首页 section-head-row 内部布局微调 */
  .section-head-row > div { max-width: 640px; }
</style>
