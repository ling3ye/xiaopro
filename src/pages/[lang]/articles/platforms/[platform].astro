---
/**
 * 文章平台列表页 · Paper Lab 纸感实验室
 *
 * @route /[lang]/articles/platforms/[platform]
 */

import Layout from '../../../../layouts/Layout.astro';
import Card from '../../../../components/Card.astro';
import Breadcrumb from '../../../../components/Breadcrumb.astro';
import { getCollection } from 'astro:content';
import { useTranslations, getLocalizedPath, type UIKey } from '../../../../utils/i18n';
import { languages, type SupportedLocale } from '../../../../i18n/config';

export async function getStaticPaths() {
  const paths: any[] = [];
  const PLATFORMS = ['mac', 'windows', 'linux', 'web', 'cross-platform'] as const;

  for (const lang of Object.keys(languages)) {
    for (const platform of PLATFORMS) {
      paths.push({
        params: { lang, platform }
      });
    }
  }

  return paths;
}

const { lang, platform } = Astro.params;
const currentLocale: SupportedLocale = lang as SupportedLocale;
const t = useTranslations(currentLocale);

const platformLabel = t(`articles.platform.${platform}` as UIKey);

// 筛选包含指定 platform 的文章
const allArticles = await getCollection('articles', ({ id, data }) => {
  if (!id.startsWith(`${lang}/`)) return false;
  if (!data.platforms || data.platforms.length === 0) return false;
  return data.platforms.includes(platform);
});

allArticles.sort((a, b) =>
  new Date(b.data.date).getTime() - new Date(a.data.date).getTime()
);

const breadcrumbItems = [
  { label: t('nav.home'), href: getLocalizedPath('/', currentLocale) },
  { label: t('nav.articles'), href: getLocalizedPath('/articles', currentLocale) },
  { label: platformLabel, current: true }
];
---
<Layout
  title={`${platformLabel} - ${t('nav.articles')}`}
  description={t('articles.platform.listingMeta').replace('{platform}', platformLabel)}
  lang={lang}
  currentPath={`/${lang}/articles/platforms/${platform}`}
>
  <section class="page-hero">
    <div class="container">
      <Breadcrumb items={breadcrumbItems} />
      <span class="eyebrow">PLATFORMS · {t('nav.articles')}</span>
      <h1>{platformLabel}</h1>
      <p class="lead">{t('articles.platform.listingMeta').replace('{platform}', platformLabel)}</p>
      <p class="hero-stats">{t('articles.listing.articleCount').replace('{count}', String(allArticles.length))}</p>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <div class="card-grid">
        {allArticles.map(art => (
          <Card
            type="article"
            title={art.data.title}
            description={art.data.intro}
            link={getLocalizedPath(`/articles/${art.data.domain}/${art.id.replace(`${lang}/`, '').replace('.md', '')}`, currentLocale)}
            tags={art.data.tags}
            date={art.data.date}
            image={art.data.image}
            locale={currentLocale}
          />
        ))}
      </div>
    </div>
  </section>
</Layout>
