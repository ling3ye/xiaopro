---
/**
 * 文章体裁列表页 · Paper Lab 纸感实验室
 *
 * @route /[lang]/articles/formats/[format]
 */

import Layout from '../../../../layouts/Layout.astro';
import Card from '../../../../components/Card.astro';
import Breadcrumb from '../../../../components/Breadcrumb.astro';
import { getCollection } from 'astro:content';
import { useTranslations, getLocalizedPath, type UIKey } from '../../../../utils/i18n';
import { languages, type SupportedLocale } from '../../../../i18n/config';

export async function getStaticPaths() {
  const paths: any[] = [];
  const FORMATS = ['tutorial', 'prompt-list', 'opinion', 'cheatsheet', 'news'] as const;

  for (const lang of Object.keys(languages)) {
    for (const format of FORMATS) {
      paths.push({
        params: { lang, format }
      });
    }
  }

  return paths;
}

const { lang, format } = Astro.params;
const currentLocale: SupportedLocale = lang as SupportedLocale;
const t = useTranslations(currentLocale);

const formatLabel = t(`articles.format.${format}` as UIKey);

// 按体裁筛选文章
const allArticles = await getCollection('articles', ({ id, data }) => {
  if (!id.startsWith(`${lang}/`)) return false;
  return data.format === format;
});

allArticles.sort((a, b) =>
  new Date(b.data.date).getTime() - new Date(a.data.date).getTime()
);

const breadcrumbItems = [
  { label: t('nav.home'), href: getLocalizedPath('/', currentLocale) },
  { label: t('nav.articles'), href: getLocalizedPath('/articles', currentLocale) },
  { label: formatLabel, current: true }
];
---
<Layout
  title={`${formatLabel} - ${t('nav.articles')}`}
  description={t('articles.format.listingMeta').replace('{format}', formatLabel)}
  lang={lang}
  currentPath={`/${lang}/articles/formats/${format}`}
>
  <section class="page-hero">
    <div class="container">
      <Breadcrumb items={breadcrumbItems} />
      <span class="eyebrow">FORMATS · {t('nav.articles')}</span>
      <h1>{formatLabel}</h1>
      <p class="lead">{t('articles.format.listingMeta').replace('{format}', formatLabel)}</p>
      <p class="hero-stats">{t('articles.listing.articleCount').replace('{count}', String(allArticles.length))}</p>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <div class="card-grid">
        {allArticles.map(art => (
          <Card
            type="article"
            title={art.data.title}
            description={art.data.intro}
            link={getLocalizedPath(`/articles/${art.data.domain}/${art.id.replace(`${lang}/`, '').replace('.md', '')}`, currentLocale)}
            tags={art.data.tags}
            date={art.data.date}
            image={art.data.image}
            locale={currentLocale}
          />
        ))}
      </div>
    </div>
  </section>
</Layout>
